@using System.Security.Claims
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeNest Airbnb Vacation Rentals</title>
    
    <!-- PWA Manifest & Meta -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#ff385c" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ff385c'><path d='M12 2.1l8 7.2v11.7c0 .6-.4 1-1 1h-5v-6h-4v6H5c-.6 0-1-.4-1-1V9.3l8-7.2z'/></svg>" />

    <!-- Google Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Leaflet CSS for Map -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    
    <!-- Custom Airbnb Theme CSS -->
    <style>
        :root {
            --primary: #ff385c;
            --primary-hover: #e00b41;
            --primary-light: #fff1f2;
            --secondary: #008489;
            --dark: #222222;
            --gray-700: #717171;
            --gray-200: #ebebeb;
            --gray-100: #f7f7f7;
            --card-radius: 16px;
            --bg-color: #ffffff;
            --text-color: #222222;
            --card-bg: #ffffff;
            --border-color: #ebebeb;
        }

        [data-theme="dark"] {
            --bg-color: #0f172a;
            --text-color: #f8fafc;
            --card-bg: #1e293b;
            --border-color: #334155;
            --gray-100: #1e293b;
            --gray-200: #334155;
            --gray-700: #94a3b8;
            --primary-light: rgba(255, 56, 92, 0.15);
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            transition: background-color 0.25s ease, color 0.25s ease;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Demo Mode Top Bar */
        .demo-bar {
            background: linear-gradient(90deg, #1e293b 0%, #0f172a 100%);
            color: #f8fafc;
            font-size: 0.8rem;
            padding: 6px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .demo-badge {
            background: #ff385c;
            color: white;
            padding: 2px 8px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.72rem;
            letter-spacing: 0.5px;
        }
        .demo-btn {
            background: rgba(255,255,255,0.12);
            color: #f8fafc;
            border: 1px solid rgba(255,255,255,0.2);
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s;
        }
        .demo-btn:hover, .demo-btn.active {
            background: white;
            color: #0f172a;
            font-weight: 700;
        }

        /* Airbnb Navbar */
        .navbar-airbnb {
            background: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1020;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        }
        .brand-logo {
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--primary) !important;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            letter-spacing: -0.5px;
        }
        .brand-logo:hover {
            color: var(--primary-hover) !important;
        }

        .nav-link-airbnb {
            color: var(--text-color);
            font-weight: 600;
            font-size: 0.92rem;
            padding: 8px 14px;
            border-radius: 24px;
            text-decoration: none;
            transition: background 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .nav-link-airbnb:hover {
            background: var(--gray-100);
            color: var(--primary);
        }

        .user-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 5px 6px 5px 14px;
            border: 1px solid var(--border-color);
            border-radius: 30px;
            background: var(--card-bg);
            cursor: pointer;
            transition: box-shadow 0.2s;
        }
        .user-pill:hover {
            box-shadow: 0 2px 6px rgba(0,0,0,0.12);
        }

        /* Primary Airbnb Buttons */
        .btn-airbnb {
            background: linear-gradient(90deg, #ff385c 0%, #e00b41 100%);
            color: white;
            font-weight: 600;
            border: none;
            border-radius: 12px;
            padding: 10px 20px;
            transition: all 0.2s;
        }
        .btn-airbnb:hover {
            opacity: 0.95;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(255, 56, 92, 0.35);
        }

        .btn-outline-airbnb {
            border: 1.5px solid var(--border-color);
            background: transparent;
            color: var(--text-color);
            font-weight: 600;
            border-radius: 12px;
            padding: 9px 18px;
            transition: all 0.2s;
        }
        .btn-outline-airbnb:hover {
            border-color: var(--dark);
            background: var(--gray-100);
            color: var(--text-color);
        }

        .badge-role {
            font-size: 0.72rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 12px;
        }
        .badge-role-guest { background: #e0f2fe; color: #0284c7; }
        .badge-role-host { background: #fef3c7; color: #d97706; }
        .badge-role-admin { background: #fee2e2; color: #dc2626; }

        /* Currency & Theme controls */
        .quick-tool-btn {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-color);
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
        }
        .quick-tool-btn:hover {
            background: var(--gray-100);
        }

        /* Card stylings */
        .card-custom {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--card-radius);
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            overflow: hidden;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .card-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        }

        footer {
            margin-top: auto;
            background: var(--card-bg);
            border-top: 1px solid var(--border-color);
            padding: 24px 0;
            font-size: 0.88rem;
            color: var(--gray-700);
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- DEMO MODE QUICK SWITCHER (TAR UMT Assignment Assessment) -->
    <div class="demo-bar d-flex flex-wrap justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <span class="demo-badge"><i class="bi bi-shield-check"></i> BMIT2023 DEMO MODE</span>
            <span class="d-none d-md-inline text-secondary-subtle">Airbnb Short-Stay System (8 Core Modules Active)</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-white-50 d-none d-sm-inline">Switch Role:</span>
            <a href="/Account/SwitchRole?role=Guest" class="demo-btn @(User.IsInRole("Guest") ? "active" : "")"><i class="bi bi-person"></i> Guest (Nurul)</a>
            <a href="/Account/SwitchRole?role=Host" class="demo-btn @(User.IsInRole("Host") ? "active" : "")"><i class="bi bi-house-door"></i> Host (Tan Ah Kow)</a>
            <a href="/Account/SwitchRole?role=Admin" class="demo-btn @(User.IsInRole("Admin") ? "active" : "")"><i class="bi bi-shield-lock"></i> Admin</a>
        </div>
    </div>

    <!-- MAIN AIRBNB NAVBAR -->
    <header class="navbar-airbnb">
        <div class="container-fluid px-lg-5">
            <div class="d-flex justify-content-between align-items-center">
                
                <!-- Logo & Brand -->
                <div class="d-flex align-items-center gap-4">
                    <a class="brand-logo" asp-controller="Property" asp-action="Catalog">
                        <i class="bi bi-houses-fill"></i>
                        <span>HomeNest</span>
                    </a>

                    <!-- Navigation Links -->
                    <nav class="d-none d-lg-flex align-items-center gap-1">
                        <a class="nav-link-airbnb" asp-controller="Property" asp-action="Catalog">
                            <i class="bi bi-compass"></i> Explore Stays
                        </a>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a class="nav-link-airbnb" asp-controller="Booking" asp-action="MyBookings">
                                <i class="bi bi-suitcase-lg"></i> My Trips
                            </a>
                            <a class="nav-link-airbnb" asp-controller="Property" asp-action="Wishlist">
                                <i class="bi bi-heart"></i> Wishlist
                            </a>
                            <a class="nav-link-airbnb" asp-controller="Booking" asp-action="Maintenance">
                                <i class="bi bi-tools"></i> Support / Issues
                            </a>
                        }
                    </nav>
                </div>

                <!-- Right Side Controls (Host shortcuts, Theme, Currency, Account) -->
                <div class="d-flex align-items-center gap-3">
                    
                    <!-- PWA Push Notification Activation Button -->
                    <button id="btnPwaNotify" class="quick-tool-btn d-none d-md-inline-flex align-items-center gap-1" title="Enable Desktop Push Check-In Reminders">
                        <i class="bi bi-bell"></i> <span>Notifications</span>
                    </button>

                    <!-- Currency Switcher -->
                    <div class="dropdown">
                        <button class="quick-tool-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" id="currencyBtn">
                            <i class="bi bi-cash-stack"></i> <span id="currentCurrencyLabel">MYR (RM)</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius:12px;">
                            <li><h6 class="dropdown-header">Select Currency</h6></li>
                            <li><a class="dropdown-item currency-select" href="#" data-currency="MYR" data-rate="1" data-symbol="RM">🇲🇾 MYR - Ringgit (RM)</a></li>
                            <li><a class="dropdown-item currency-select" href="#" data-currency="USD" data-rate="0.225" data-symbol="$">🇺🇸 USD - US Dollar ($)</a></li>
                            <li><a class="dropdown-item currency-select" href="#" data-currency="SGD" data-rate="0.301" data-symbol="S$">🇸🇬 SGD - Singapore Dollar (S$)</a></li>
                        </ul>
                    </div>

                    <!-- Dark / Light Theme Switcher -->
                    <button id="themeToggleBtn" class="quick-tool-btn" title="Toggle Dark/Light Mode">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>

                    <!-- Host Portals (Host or Admin only) -->
                    @if (User.IsInRole("Host") || User.IsInRole("Admin"))
                    {
                        <div class="dropdown d-none d-md-inline">
                            <button class="btn btn-outline-airbnb dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-house-gear"></i> Host Console
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius:14px; min-width:210px;">
                                <li><h6 class="dropdown-header">Listing Management</h6></li>
                                <li><a class="dropdown-item" asp-controller="Property" asp-action="MyProperties"><i class="bi bi-grid-fill me-2"></i> My Properties</a></li>
                                <li><a class="dropdown-item" asp-controller="Property" asp-action="Create"><i class="bi bi-plus-circle me-2"></i> Add New Listing</a></li>
                                <li><a class="dropdown-item" asp-controller="Property" asp-action="BatchImport"><i class="bi bi-file-earmark-spreadsheet me-2"></i> Batch CSV Rate Import</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Operations & Payouts</h6></li>
                                <li><a class="dropdown-item" asp-controller="Booking" asp-action="QrScanner"><i class="bi bi-qr-code-scan me-2 text-danger"></i> QR Check-In Scanner</a></li>
                                <li><a class="dropdown-item" asp-controller="Booking" asp-action="HostEarnings"><i class="bi bi-wallet2 me-2 text-success"></i> Earnings & Payouts</a></li>
                                <li><a class="dropdown-item" asp-controller="Booking" asp-action="HostDashboard"><i class="bi bi-graph-up-arrow me-2 text-primary"></i> Performance Analytics</a></li>
                            </ul>
                        </div>
                    }

                    <!-- Admin Portal (Admin only) -->
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="dropdown d-none d-md-inline">
                            <button class="btn btn-outline-danger dropdown-toggle" type="button" data-bs-toggle="dropdown" style="border-radius:12px;">
                                <i class="bi bi-shield-lock-fill"></i> Admin
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius:14px; min-width:230px;">
                                <li><h6 class="dropdown-header text-danger">Platform Oversight</h6></li>
                                <li><a class="dropdown-item" asp-controller="Booking" asp-action="AdminDashboard"><i class="bi bi-speedometer2 me-2"></i> Platform Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Users"><i class="bi bi-people-fill me-2"></i> Users & Host Verification</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="AuditLogs"><i class="bi bi-journal-text me-2"></i> Security Audit Logs</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-primary" asp-controller="Booking" asp-action="ExportFinancialCsv"><i class="bi bi-download me-2"></i> Export Financial CSV</a></li>
                            </ul>
                        </div>
                    }

                    <!-- User Account Pill Dropdown -->
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        string fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "User";
                        string role = User.FindFirstValue(ClaimTypes.Role) ?? "Guest";
                        string roleBadgeClass = role switch { "Admin" => "badge-role-admin", "Host" => "badge-role-host", _ => "badge-role-guest" };

                        <div class="dropdown">
                            <div class="user-pill dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="bi bi-list fs-6"></i>
                                <div class="d-none d-sm-block text-start" style="line-height:1.2;">
                                    <span class="fw-bold d-block text-truncate" style="max-width:110px; font-size:0.85rem;">@fullName</span>
                                    <span class="badge-role @roleBadgeClass">@role</span>
                                </div>
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:32px; height:32px; font-weight:700; font-size:0.85rem;">
                                    @(fullName.Length > 0 ? fullName[0].ToString().ToUpper() : "U")
                                </div>
                            </div>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius:14px; min-width:210px;">
                                <li><h6 class="dropdown-header">Signed in as <strong>@fullName</strong></h6></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-gear me-2"></i> Profile & Webcam Photo</a></li>
                                <li><a class="dropdown-item" asp-controller="Booking" asp-action="MyBookings"><i class="bi bi-suitcase-lg me-2"></i> My Trips</a></li>
                                <li><a class="dropdown-item" asp-controller="Property" asp-action="Wishlist"><i class="bi bi-heart me-2"></i> Wishlist Folders</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn-outline-airbnb text-decoration-none" asp-controller="Account" asp-action="Login">Log In</a>
                            <a class="btn-airbnb text-decoration-none" asp-controller="Account" asp-action="Register">Sign Up</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- SYSTEM ALERTS / TEMPDATA BANNER -->
    <div class="container-fluid px-lg-5 mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="border-radius:12px;">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="border-radius:12px;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ActivationSimulationLink"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert" style="border-radius:12px;">
                <strong><i class="bi bi-envelope-check-fill me-2"></i> Email Activation Simulation:</strong>
                Click here to verify: <a href="@TempData["ActivationSimulationLink"]" class="fw-bold alert-link">@TempData["ActivationSimulationLink"]</a>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ResetSimulationLink"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert" style="border-radius:12px;">
                <strong><i class="bi bi-key-fill me-2"></i> Password Reset Simulation:</strong>
                Click here to reset password: <a href="@TempData["ResetSimulationLink"]" class="fw-bold alert-link">@TempData["ResetSimulationLink"]</a>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- MAIN BODY -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer>
        <div class="container-fluid px-lg-5">
            <div class="row g-4 justify-content-between align-items-center">
                <div class="col-md-6">
                    <p class="mb-1 fw-bold text-dark-emphasis">HomeNest Vacation Rentals & Airbnb Booking System</p>
                    <p class="mb-0 text-muted" style="font-size:0.8rem;">
                        Built for TAR UMT BMIT2023 Web and Mobile Systems Assignment. Fully compliant with .NET 10, EF Core Code-First with Data Annotations, and Manual Cookie-Based Authentication.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-flex flex-wrap justify-content-md-end gap-3" style="font-size:0.82rem;">
                        <span><i class="bi bi-shield-check text-success"></i> 3-Strike Lockout Active</span>
                        <span><i class="bi bi-camera text-primary"></i> Live Webcam Enabled</span>
                        <span><i class="bi bi-qr-code text-danger"></i> QR Pass Scanner</span>
                        <span><i class="bi bi-bar-chart text-info"></i> Chart.js Analytics</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- PWA & UI Preference Scripts (Theme & Currency) -->
    <script>
        // 1. Theme Management (Dark/Light)
        (function() {
            const savedTheme = localStorage.getItem('homenest_theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
            updateThemeIcon(savedTheme);

            document.getElementById('themeToggleBtn').addEventListener('click', function() {
                const current = document.documentElement.getAttribute('data-theme');
                const next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('homenest_theme', next);
                updateThemeIcon(next);
            });

            function updateThemeIcon(theme) {
                const icon = document.getElementById('themeIcon');
                if (theme === 'dark') {
                    icon.className = 'bi bi-sun-fill text-warning';
                } else {
                    icon.className = 'bi bi-moon-stars';
                }
            }
        })();

        // 2. Global Currency Switcher (MYR, USD, SGD)
        (function() {
            const savedCurrency = localStorage.getItem('homenest_currency') || 'MYR';
            const savedSymbol = localStorage.getItem('homenest_symbol') || 'RM';
            const savedRate = parseFloat(localStorage.getItem('homenest_rate')) || 1.0;

            updateCurrencyDisplay(savedCurrency, savedSymbol);

            document.querySelectorAll('.currency-select').forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const currency = this.getAttribute('data-currency');
                    const rate = parseFloat(this.getAttribute('data-rate'));
                    const symbol = this.getAttribute('data-symbol');

                    localStorage.setItem('homenest_currency', currency);
                    localStorage.setItem('homenest_rate', rate);
                    localStorage.setItem('homenest_symbol', symbol);

                    updateCurrencyDisplay(currency, symbol);
                    convertAllPrices(rate, symbol);
                });
            });

            function updateCurrencyDisplay(cur, sym) {
                const label = document.getElementById('currentCurrencyLabel');
                if (label) label.textContent = `${cur} (${sym})`;
            }

            function convertAllPrices(rate, symbol) {
                document.querySelectorAll('[data-base-price]').forEach(el => {
                    const base = parseFloat(el.getAttribute('data-base-price'));
                    if (!isNaN(base)) {
                        const converted = (base * rate).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
                        el.textContent = `${symbol} ${converted}`;
                    }
                });
            }

            // Initial conversion on page load
            if (savedRate !== 1.0) {
                convertAllPrices(savedRate, savedSymbol);
            }
        })();

        // 3. PWA Push Notifications & Service Worker Registration
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW failed', err));
            });
        }

        const notifyBtn = document.getElementById('btnPwaNotify');
        if (notifyBtn) {
            notifyBtn.addEventListener('click', async () => {
                if (!('Notification' in window)) {
                    alert('This browser does not support desktop notifications.');
                    return;
                }
                const perm = await Notification.requestPermission();
                if (perm === 'granted') {
                    new Notification('HomeNest Check-In Reminder', {
                        body: 'Reminder: Check-in for your reservation is today at 3:00 PM! Click to open your digital QR pass.',
                        icon: '/favicon.ico'
                    });
                    alert('Desktop push reminders successfully enabled!');
                } else {
                    alert('Notification permission was denied.');
                }
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
