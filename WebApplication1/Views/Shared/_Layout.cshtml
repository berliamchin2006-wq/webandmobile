<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeNest House and Room Rental System</title>
    <!-- Google Font Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Leaflet.js CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Custom Styling to match reference mockup -->
    <style>
        :root {
            --hn-primary: #0d9488;
            --hn-primary-dark: #0f766e;
            --hn-primary-subtle: #f0fdfa;
            --hn-dark-teal: #08211b;
            --hn-accent-gold: #f59e0b;
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        .demo-bar {
            background-color: #0b1120;
            color: #94a3b8;
            font-size: 0.8rem;
        }

        .navbar-brand-custom {
            display: flex;
            align-items: center;
            text-decoration: none;
        }

        .brand-logo-sq {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #0d9488, #14b8a6);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 1.25rem;
            box-shadow: 0 4px 6px -1px rgba(13, 148, 136, 0.2);
        }

        .nav-pill-link {
            color: #475569;
            font-size: 0.88rem;
            font-weight: 600;
            padding: 0.45rem 0.85rem;
            border-radius: 8px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.15s ease-in-out;
        }

        .nav-pill-link:hover {
            color: #0d9488;
            background-color: #f1f5f9;
        }

        .nav-pill-link.active {
            color: #0d9488;
            background-color: #e6f7f5;
            font-weight: 700;
        }

        .hero-banner {
            background: radial-gradient(circle at 85% 15%, #0f3d32 0%, #08201a 55%, #041410 100%);
            border-radius: 24px;
            color: #ffffff;
            box-shadow: 0 20px 25px -5px rgba(4, 20, 16, 0.35);
        }

        .hero-verified-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 4px 14px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: #a7f3d0;
            font-size: 0.82rem;
            font-weight: 600;
            border-radius: 50rem;
            backdrop-filter: blur(4px);
        }

        .search-card-floating {
            background: #ffffff;
            border-radius: 18px;
            padding: 1.4rem 1.5rem;
            color: #1e293b;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.08);
        }

        .search-label-micro {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            color: #64748b;
            text-transform: uppercase;
            margin-bottom: 0.35rem;
            display: block;
        }

        .custom-teal-range::-webkit-slider-thumb {
            background: #0d9488;
        }
        .custom-teal-range::-moz-range-thumb {
            background: #0d9488;
        }

        .amenity-chip-check {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.82rem;
            font-weight: 500;
            color: #334155;
            cursor: pointer;
            margin-right: 0.8rem;
            user-select: none;
        }

        .amenity-chip-check input {
            accent-color: #0d9488;
            cursor: pointer;
        }

        .btn-toggle-map {
            color: #0d9488;
            border: 1px solid #0d9488;
            background: #f0fdfa;
            border-radius: 50rem;
            padding: 0.35rem 1rem;
            font-size: 0.82rem;
            font-weight: 700;
            transition: all 0.2s ease;
        }

        .btn-toggle-map:hover {
            background: #0d9488;
            color: #ffffff;
        }

        .property-card-modern {
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            overflow: hidden;
            background: #ffffff;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .property-card-modern:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 20px -5px rgba(0,0,0,0.08);
        }

        .quick-filter-chip {
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #475569;
            font-size: 0.78rem;
            font-weight: 600;
            padding: 0.25rem 0.75rem;
            border-radius: 50rem;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
        }

        .quick-filter-chip:hover, .quick-filter-chip.active {
            background: #0d9488;
            color: #ffffff;
            border-color: #0d9488;
        }
    </style>
</head>
<body>
    <!-- Top Demo Mode & Instant Role Switcher Bar -->
    @{
        var currentUserRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
        var currentUserName = User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? (User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Guest");
        bool isGuest = User.Identity?.IsAuthenticated != true;
        bool isTenant = currentUserRole == "Tenant";
        bool isOwner = currentUserRole == "Owner";
        bool isAdmin = currentUserRole == "Admin";
    }

    <header>
        <div class="demo-bar py-1 px-3 border-bottom border-dark">
            <div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 mb-1 mb-md-0">
                    <span class="badge" style="background-color: #0d9488; font-size: 10.5px; font-weight: 700; letter-spacing: 0.4px;">BMIT2023 DEMO MODE</span>
                    <span class="text-white-50" style="font-size: 11.5px;">Instant Role Switcher (or use Login button to test 3-strike lockout & Captcha):</span>
                </div>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <a asp-controller="Account" asp-action="SwitchGuest" asp-route-returnUrl="@Context.Request.Path" 
                       class="btn btn-sm py-0 px-2 text-white @(isGuest ? "btn-secondary" : "btn-outline-secondary")" style="font-size: 11.5px; border-radius: 6px;">
                        <i class="bi bi-eye me-1"></i> Guest
                    </a>
                    <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="Tenant" asp-route-returnUrl="@Context.Request.Path" 
                       class="btn btn-sm py-0 px-2 text-white @(isTenant ? "border-0" : "btn-outline-secondary")" style="font-size: 11.5px; border-radius: 6px; @(isTenant ? "background-color: #059669;" : "")">
                        👨‍🎓 Tenant (Nurul Aina)
                    </a>
                    <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="Owner" asp-route-returnUrl="@Context.Request.Path" 
                       class="btn btn-sm py-0 px-2 text-white @(isOwner ? "border-0 bg-warning text-dark" : "btn-outline-secondary")" style="font-size: 11.5px; border-radius: 6px;">
                        🏠 House Owner (Tan Ah Kow)
                    </a>
                    <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="Admin" asp-route-returnUrl="@Context.Request.Path" 
                       class="btn btn-sm py-0 px-2 text-white @(isAdmin ? "border-0 bg-danger" : "btn-outline-secondary")" style="font-size: 11.5px; border-radius: 6px;">
                        👤 Admin
                    </a>
                    <a asp-controller="Account" asp-action="ResetData" asp-route-returnUrl="@Context.Request.Path" 
                       class="btn btn-sm btn-outline-secondary py-0 px-2 text-light" style="font-size: 11.5px; border-radius: 6px;" title="Reset database to fresh demo state">
                        <i class="bi bi-arrow-repeat me-1"></i> Reset Data
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Navigation Bar -->
        <nav class="navbar navbar-expand-xl bg-white border-bottom shadow-sm py-2">
            <div class="container-fluid px-lg-4">
                <!-- Brand -->
                <a class="navbar-brand-custom me-4" asp-controller="Property" asp-action="Catalog">
                    <div class="brand-logo-sq me-2">
                        <i class="bi bi-house-door-fill"></i>
                    </div>
                    <div class="d-flex flex-column lh-1">
                        <span class="fw-bold fs-5 tracking-tight" style="color: #0f172a;">HomeNest</span>
                        <span class="text-uppercase text-muted" style="font-size: 9px; letter-spacing: 0.5px; font-weight: 700;">MY House & Room Rental</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#homenestNav" aria-controls="homenestNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="homenestNav">
                    <!-- Nav Tabs -->
                    @{
                        string currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                        string currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                    }
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-pill-link @(currentCtrl == "Property" && currentAct == "Catalog" ? "active" : "")" asp-controller="Property" asp-action="Catalog">
                                <i class="bi bi-search text-teal"></i> Browse Rentals
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-pill-link @(currentCtrl == "Booking" && currentAct == "ViewingPasses" ? "active" : "")" asp-controller="Booking" asp-action="ViewingPasses">
                                <i class="bi bi-calendar3"></i> Viewing Passes 
                                <span class="badge rounded-pill" style="background-color: #ccfbf1; color: #0f766e; font-size: 10px;">1</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-pill-link @(currentCtrl == "Booking" && currentAct == "Leases" ? "active" : "")" asp-controller="Booking" asp-action="Leases">
                                <i class="bi bi-file-earmark-text"></i> Leases & Billing
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-pill-link @(currentCtrl == "Booking" && currentAct == "Maintenance" ? "active" : "")" asp-controller="Booking" asp-action="Maintenance">
                                <i class="bi bi-tools"></i> Maintenance
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-pill-link @(currentCtrl == "Property" && currentAct == "MyProperties" ? "active" : "")" asp-controller="Property" asp-action="MyProperties">
                                <i class="bi bi-building"></i> Owner Portal
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-pill-link @(currentCtrl == "Booking" && currentAct == "Dashboard" ? "active" : "")" asp-controller="Booking" asp-action="Dashboard">
                                <i class="bi bi-pie-chart"></i> Admin & Analytics
                            </a>
                        </li>
                    </ul>

                    <!-- Right Controls -->
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0 fw-semibold" style="font-size: 11px;">EN</button>
                        <button class="btn btn-sm btn-link text-secondary p-0 text-decoration-none" id="darkModeBtn" title="Toggle dark mode">
                            <i class="bi bi-moon fs-5"></i>
                        </button>
                        <a href="javascript:void(0)" class="btn btn-sm btn-link text-secondary p-0 text-decoration-none position-relative" title="Favorites">
                            <i class="bi bi-heart fs-5 text-danger"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 9px;">1</span>
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown ps-2 border-start">
                                <a class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="text-end lh-1">
                                        <div class="fw-bold small text-dark">@currentUserName</div>
                                        <span class="badge" style="background-color: #ecfdf5; color: #059669; font-size: 10px; font-weight: 700;">@currentUserRole</span>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2">
                                    <li>
                                        <a class="dropdown-item py-2 small" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear me-2 text-muted"></i> My Profile
                                        </a>
                                    </li>
                                    @if (isAdmin)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 small" asp-controller="Account" asp-action="Users">
                                                <i class="bi bi-people me-2 text-primary"></i> Manage Users
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2 small text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-power me-2"></i> Log Out
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 ps-2 border-start">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary fw-semibold px-3 py-1" style="border-radius: 8px;">Log In</a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary fw-semibold px-3 py-1 text-white" style="background-color: #0d9488; border-color: #0d9488; border-radius: 8px;">Register</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <main role="main" class="container-fluid px-lg-4 py-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-3 py-2" role="alert">
                <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-3 py-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer bg-white border-top text-muted py-3 mt-5">
        <div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between align-items-center small">
            <div>
                &copy; 2026 <strong>HomeNest</strong> (BMIT2023 House and Room Rental System). Built for student & professional accommodation.
            </div>
            <div class="d-flex gap-3 text-secondary">
                <span>Verified Landlords</span>
                <span>•</span>
                <span>QR Viewing Passes</span>
                <span>•</span>
                <span>Instant E-Receipts</span>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Dark mode toggle
        const dmBtn = document.getElementById("darkModeBtn");
        if (dmBtn) {
            dmBtn.addEventListener("click", () => {
                const html = document.documentElement;
                const current = html.getAttribute("data-bs-theme");
                const next = current === "dark" ? "light" : "dark";
                html.setAttribute("data-bs-theme", next);
                dmBtn.innerHTML = next === "dark" ? '<i class="bi bi-sun fs-5 text-warning"></i>' : '<i class="bi bi-moon fs-5"></i>';
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
