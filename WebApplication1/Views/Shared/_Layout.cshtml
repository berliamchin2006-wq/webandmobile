@using System.Security.Claims
<!DOCTYPE html>
<html lang="en" data-theme="light" data-radius="soft" data-buttons="pill" data-motion="on">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - HomeNest Vacation Rentals</title>
    
    <!-- PWA Manifest & Meta -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#ff385c" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ff385c'><path d='M12 2.1l8 7.2v11.7c0 .6-.4 1-1 1h-5v-6h-4v6H5c-.6 0-1-.4-1-1V9.3l8-7.2z'/></svg>" />

    <!-- Google Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Leaflet CSS for Map -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    
    <!-- Taste Design System CSS -->
    <link rel="stylesheet" href="~/css/taste-design-system.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#mainContent">Skip to content</a>

    <!-- DEMO MODE QUICK SWITCHER (TAR UMT Assignment Assessment) -->
    <div class="taste-demo-bar">
        <div class="taste-wrap d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="taste-demo-badge"><i class="bi bi-shield-check"></i> BMIT2023 SHOWCASE</span>
                <span class="d-none d-md-inline text-white-50" style="font-size:0.75rem;">Verified Vacation Rental Platform · 8 Core Modules Active</span>
            </div>
            <div class="d-flex align-items-center gap-1 gap-sm-2">
                <span class="text-white-50 d-none d-sm-inline" style="font-size:0.75rem;">Switch Demo:</span>
                <a href="/Account/SwitchRole?role=Guest" class="taste-demo-pill @(User.IsInRole("Guest") ? "active" : "")">
                    <i class="bi bi-person"></i> Guest
                </a>
                <a href="/Account/SwitchRole?role=Host" class="taste-demo-pill @(User.IsInRole("Host") ? "active" : "")">
                    <i class="bi bi-house-door"></i> Host
                </a>
                <a href="/Account/SwitchRole?role=Admin" class="taste-demo-pill @(User.IsInRole("Admin") ? "active" : "")">
                    <i class="bi bi-shield-lock"></i> Admin
                </a>
            </div>
        </div>
    </div>

    <!-- MAIN NAVBAR (Sticky & Glassmorphic) -->
    <header class="navbar-taste">
        <div class="taste-wrap">
            <div class="d-flex justify-content-between align-items-center gap-2">
                
                <!-- Brand & Logo -->
                <div class="d-flex align-items-center gap-4">
                    <a class="taste-brand" asp-controller="Property" asp-action="Catalog">
                        <span class="taste-brand-logo-mark">
                            <i class="bi bi-houses-fill"></i>
                        </span>
                        <span class="d-none d-sm-inline">HomeNest</span>
                    </a>

                    <!-- Navigation Links -->
                    <nav class="d-none d-lg-flex align-items-center gap-1" aria-label="Main Navigation">
                        <a class="nav-link-taste @(ViewContext.RouteData.Values["controller"]?.ToString() == "Property" && ViewContext.RouteData.Values["action"]?.ToString() == "Catalog" ? "active" : "")" 
                           asp-controller="Property" asp-action="Catalog">
                            <i class="bi bi-compass"></i> Explore Stays
                        </a>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a class="nav-link-taste @(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" && ViewContext.RouteData.Values["action"]?.ToString() == "MyBookings" ? "active" : "")" 
                               asp-controller="Booking" asp-action="MyBookings">
                                <i class="bi bi-suitcase-lg"></i> My Trips
                            </a>
                            <a class="nav-link-taste @(ViewContext.RouteData.Values["controller"]?.ToString() == "Property" && ViewContext.RouteData.Values["action"]?.ToString() == "Wishlist" ? "active" : "")" 
                               asp-controller="Property" asp-action="Wishlist">
                                <i class="bi bi-heart"></i> Wishlist
                            </a>
                            <a class="nav-link-taste @(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" && ViewContext.RouteData.Values["action"]?.ToString() == "Maintenance" ? "active" : "")" 
                               asp-controller="Booking" asp-action="Maintenance">
                                <i class="bi bi-tools"></i> Support / Issues
                            </a>
                        }
                    </nav>
                </div>

                <!-- Right Side Controls (Tools, Portals, User Pill) -->
                <div class="d-flex align-items-center gap-2">
                    
                    <!-- PWA Push Notifications Button -->
                    <button id="btnPwaNotify" class="taste-tool-btn d-none d-xl-inline-flex" title="Enable Desktop Push Check-In Reminders">
                        <i class="bi bi-bell"></i> <span>Notifications</span>
                    </button>

                    <!-- Multi-Currency Selector Dropdown -->
                    <div class="dropdown">
                        <button class="taste-tool-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" id="currencyBtn" aria-expanded="false">
                            <i class="bi bi-cash-stack"></i> <span id="currentCurrencyLabel" class="d-none d-sm-inline">MYR (RM)</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border" style="border-radius:14px; min-width: 190px;">
                            <li><h6 class="dropdown-header text-uppercase" style="font-size:0.7rem; letter-spacing:0.05em;">Select Currency</h6></li>
                            <li><a class="dropdown-item currency-select fw-semibold" href="#" data-currency="MYR" data-rate="1" data-symbol="RM">🇲🇾 MYR - Ringgit (RM)</a></li>
                            <li><a class="dropdown-item currency-select fw-semibold" href="#" data-currency="USD" data-rate="0.225" data-symbol="$">🇺🇸 USD - US Dollar ($)</a></li>
                            <li><a class="dropdown-item currency-select fw-semibold" href="#" data-currency="SGD" data-rate="0.301" data-symbol="S$">🇸🇬 SGD - Singapore Dollar (S$)</a></li>
                        </ul>
                    </div>

                    <!-- Dark / Light Theme Toggle -->
                    <button id="themeToggleBtn" class="taste-tool-btn" title="Toggle Dark/Light Mode" aria-label="Toggle theme">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>

                    <!-- Host Portals (Host or Admin only) -->
                    @if (User.IsInRole("Host") || User.IsInRole("Admin"))
                    {
                        <div class="dropdown d-none d-md-inline">
                            <button class="btn btn-outline-taste dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-house-gear text-danger"></i> Host Console
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border" style="border-radius:14px; min-width:220px;">
                                <li><h6 class="dropdown-header text-uppercase" style="font-size:0.7rem; letter-spacing:0.05em;">Listing Management</h6></li>
                                <li><a class="dropdown-item py-2" asp-controller="Property" asp-action="MyProperties"><i class="bi bi-grid-fill me-2 text-primary"></i> My Properties</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Property" asp-action="Create"><i class="bi bi-plus-circle me-2 text-success"></i> Add New Listing</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Property" asp-action="BatchImport"><i class="bi bi-file-earmark-spreadsheet me-2 text-info"></i> Batch CSV Rate Import</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header text-uppercase" style="font-size:0.7rem; letter-spacing:0.05em;">Operations & Payouts</h6></li>
                                <li><a class="dropdown-item py-2" asp-controller="Booking" asp-action="QrScanner"><i class="bi bi-qr-code-scan me-2 text-danger"></i> QR Check-In Scanner</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Booking" asp-action="HostEarnings"><i class="bi bi-wallet2 me-2 text-success"></i> Earnings & Payouts</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Booking" asp-action="HostDashboard"><i class="bi bi-graph-up-arrow me-2 text-primary"></i> Performance Analytics</a></li>
                            </ul>
                        </div>
                    }

                    <!-- Admin Portal (Admin only) -->
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="dropdown d-none d-md-inline">
                            <button class="btn btn-outline-danger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius:12px; font-weight:600;">
                                <i class="bi bi-shield-lock-fill"></i> Admin
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border" style="border-radius:14px; min-width:240px;">
                                <li><h6 class="dropdown-header text-danger text-uppercase" style="font-size:0.7rem; letter-spacing:0.05em;">Platform Oversight</h6></li>
                                <li><a class="dropdown-item py-2" asp-controller="Booking" asp-action="AdminDashboard"><i class="bi bi-speedometer2 me-2 text-danger"></i> Platform Dashboard</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Users"><i class="bi bi-people-fill me-2 text-primary"></i> Users & Host Verification</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="AuditLogs"><i class="bi bi-journal-text me-2 text-secondary"></i> Security Audit Logs</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-primary fw-semibold" asp-controller="Booking" asp-action="ExportFinancialCsv"><i class="bi bi-download me-2"></i> Export Financial CSV</a></li>
                            </ul>
                        </div>
                    }

                    <!-- User Account Pill Dropdown -->
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        string fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "User";
                        string role = User.FindFirstValue(ClaimTypes.Role) ?? "Guest";
                        string roleColor = role switch { "Admin" => "text-danger bg-danger-subtle", "Host" => "text-warning-emphasis bg-warning-subtle", _ => "text-primary bg-primary-subtle" };

                        <div class="dropdown">
                            <div class="taste-user-pill dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" role="button" tabindex="0">
                                <i class="bi bi-list fs-6"></i>
                                <div class="d-none d-sm-block text-start" style="line-height:1.2;">
                                    <span class="fw-bold d-block text-truncate" style="max-width:110px; font-size:0.84rem;">@fullName</span>
                                    <span class="badge rounded-pill px-2 py-0 @roleColor" style="font-size:0.68rem; font-weight:700;">@role</span>
                                </div>
                                <div class="taste-user-avatar">
                                    @(fullName.Length > 0 ? fullName[0].ToString().ToUpper() : "U")
                                </div>
                            </div>
                            <ul class="dropdown-menu dropdown-menu-end shadow border" style="border-radius:14px; min-width:220px;">
                                <li><h6 class="dropdown-header">Signed in as <strong>@fullName</strong></h6></li>
                                <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-gear me-2 text-secondary"></i> Profile & Webcam Photo</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Booking" asp-action="MyBookings"><i class="bi bi-suitcase-lg me-2 text-primary"></i> My Trips</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Property" asp-action="Wishlist"><i class="bi bi-heart me-2 text-danger"></i> Wishlist Folders</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger fw-semibold" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-1 gap-sm-2">
                            <a class="btn-outline-taste text-decoration-none px-3 py-1" style="font-size:0.84rem;" asp-controller="Account" asp-action="Login">Log In</a>
                            <a class="btn-airbnb text-decoration-none px-3 py-1" style="font-size:0.84rem;" asp-controller="Account" asp-action="Register">Sign Up</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- SYSTEM ALERTS / FLASH MESSAGES -->
    <div class="taste-wrap mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="taste-alert taste-alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="taste-alert taste-alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ActivationSimulationLink"] != null)
        {
            <div class="taste-alert taste-alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-envelope-check-fill fs-5"></i>
                <div class="flex-grow-1">
                    <strong>Email Activation Simulation:</strong>
                    Click here to verify: <a href="@TempData["ActivationSimulationLink"]" class="fw-bold alert-link text-decoration-underline">@TempData["ActivationSimulationLink"]</a>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ResetSimulationLink"] != null)
        {
            <div class="taste-alert taste-alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-key-fill fs-5"></i>
                <div class="flex-grow-1">
                    <strong>Password Reset Simulation:</strong>
                    Click here to reset password: <a href="@TempData["ResetSimulationLink"]" class="fw-bold alert-link text-decoration-underline">@TempData["ResetSimulationLink"]</a>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- MAIN BODY -->
    <main id="mainContent" role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- TASTE FOOTER (House Rule 1: Clean single legal line) -->
    <footer class="taste-footer">
        <div class="taste-wrap">
            <div class="row g-4 justify-content-between">
                
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="taste-brand-logo-mark" style="width:28px; height:28px; font-size:0.95rem;">
                            <i class="bi bi-houses-fill"></i>
                        </span>
                        <span class="fw-bold fs-5 text-dark-emphasis">HomeNest</span>
                    </div>
                    <p class="text-muted mb-3" style="font-size:0.88rem; max-width:340px; line-height:1.6;">
                        High-trust vacation rentals and staycation residences across Malaysia with instant booking, verified superhosts, and digital QR check-in passes.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-1 font-monospace" style="font-size:0.75rem;">.NET 10 EF Core</span>
                        <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-3 py-1 font-monospace" style="font-size:0.75rem;">PWA Enabled</span>
                    </div>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="taste-footer-title">Explore Malaysia</h6>
                    <ul class="list-unstyled mb-0">
                        <li><a class="taste-footer-link" asp-controller="Property" asp-action="Catalog" asp-route-keyword="Kuala Lumpur">Kuala Lumpur Stays</a></li>
                        <li><a class="taste-footer-link" asp-controller="Property" asp-action="Catalog" asp-route-keyword="Penang">Penang Heritage Villas</a></li>
                        <li><a class="taste-footer-link" asp-controller="Property" asp-action="Catalog" asp-route-keyword="Cameron">Cameron Highlands</a></li>
                        <li><a class="taste-footer-link" asp-controller="Property" asp-action="Catalog" asp-route-keyword="Langkawi">Langkawi Beachfront</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="taste-footer-title">Hosting & Ops</h6>
                    <ul class="list-unstyled mb-0">
                        <li><a class="taste-footer-link" asp-controller="Property" asp-action="Create">List Your Property</a></li>
                        <li><a class="taste-footer-link" asp-controller="Booking" asp-action="QrScanner">QR Check-In Scanner</a></li>
                        <li><a class="taste-footer-link" asp-controller="Booking" asp-action="HostEarnings">Host Payouts</a></li>
                        <li><a class="taste-footer-link" asp-controller="Booking" asp-action="Maintenance">Maintenance & Issues</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="taste-footer-title">Platform Assurances</h6>
                    <div class="d-flex flex-column gap-2" style="font-size:0.84rem;">
                        <span class="d-flex align-items-center gap-2"><i class="bi bi-shield-check text-success"></i> 3-Strike Security Lockout</span>
                        <span class="d-flex align-items-center gap-2"><i class="bi bi-camera text-primary"></i> Live Webcam Host Verification</span>
                        <span class="d-flex align-items-center gap-2"><i class="bi bi-qr-code text-danger"></i> Encrypted QR Check-In Pass</span>
                        <span class="d-flex align-items-center gap-2"><i class="bi bi-graph-up-arrow text-info"></i> Chart.js Real-Time Analytics</span>
                    </div>
                </div>
            </div>

            <!-- Single Clean Legal Line (House Rule 1) -->
            <div class="taste-footer-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    &copy; @DateTime.Now.Year HomeNest Inc. Built for TAR UMT BMIT2023 Assignment.
                </div>
                <div class="d-flex gap-3">
                    <span class="text-muted">Interactive Leaflet GeoEngine</span>
                    <span class="text-muted">Cookie Security Scheme</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Theme & Currency & PWA Scripts -->
    <script>
        // 1. Theme Management (Dark / Light)
        (function() {
            const savedTheme = localStorage.getItem('homenest_theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
            updateThemeIcon(savedTheme);

            const toggleBtn = document.getElementById('themeToggleBtn');
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    const current = document.documentElement.getAttribute('data-theme');
                    const next = current === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-theme', next);
                    localStorage.setItem('homenest_theme', next);
                    updateThemeIcon(next);
                });
            }

            function updateThemeIcon(theme) {
                const icon = document.getElementById('themeIcon');
                if (icon) {
                    if (theme === 'dark') {
                        icon.className = 'bi bi-sun-fill text-warning';
                    } else {
                        icon.className = 'bi bi-moon-stars';
                    }
                }
            }
        })();

        // 2. Global Currency Switcher (MYR, USD, SGD) with Live Conversion
        (function() {
            const savedCurrency = localStorage.getItem('homenest_currency') || 'MYR';
            const savedSymbol = localStorage.getItem('homenest_symbol') || 'RM';
            const savedRate = parseFloat(localStorage.getItem('homenest_rate')) || 1.0;

            updateCurrencyDisplay(savedCurrency, savedSymbol);

            document.querySelectorAll('.currency-select').forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const currency = this.getAttribute('data-currency');
                    const rate = parseFloat(this.getAttribute('data-rate'));
                    const symbol = this.getAttribute('data-symbol');

                    localStorage.setItem('homenest_currency', currency);
                    localStorage.setItem('homenest_rate', rate);
                    localStorage.setItem('homenest_symbol', symbol);

                    updateCurrencyDisplay(currency, symbol);
                    convertAllPrices(rate, symbol);
                });
            });

            function updateCurrencyDisplay(cur, sym) {
                const label = document.getElementById('currentCurrencyLabel');
                if (label) label.textContent = `${cur} (${sym})`;
            }

            function convertAllPrices(rate, symbol) {
                document.querySelectorAll('[data-base-price]').forEach(el => {
                    const base = parseFloat(el.getAttribute('data-base-price'));
                    if (!isNaN(base)) {
                        const converted = (base * rate).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
                        el.textContent = `${symbol} ${converted}`;
                    }
                });
            }

            // Initial conversion on page load
            if (savedRate !== 1.0) {
                convertAllPrices(savedRate, savedSymbol);
            }
        })();

        // 3. PWA Push Notifications & Service Worker Registration
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW failed', err));
            });
        }

        const notifyBtn = document.getElementById('btnPwaNotify');
        if (notifyBtn) {
            notifyBtn.addEventListener('click', async () => {
                if (!('Notification' in window)) {
                    alert('This browser does not support desktop notifications.');
                    return;
                }
                const perm = await Notification.requestPermission();
                if (perm === 'granted') {
                    new Notification('HomeNest Check-In Reminder', {
                        body: 'Reminder: Check-in for your reservation is today at 3:00 PM! Click to open your digital QR pass.',
                        icon: '/favicon.ico'
                    });
                    alert('Desktop push reminders successfully enabled!');
                } else {
                    alert('Notification permission was denied.');
                }
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
