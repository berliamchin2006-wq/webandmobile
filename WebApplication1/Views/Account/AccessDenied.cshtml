@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-sm p-5">
            <i class="bi bi-shield-lock-fill display-1 text-danger mb-3"></i>
            <h2 class="fw-bold">Access Denied</h2>
            <p class="text-muted">You do not have the required permissions to view this resource.</p>
            <div class="mt-4">
                <a asp-controller="Property" asp-action="Catalog" class="btn btn-primary px-4">Back to Catalog</a>
            </div>
        </div>
    </div>
</div>

