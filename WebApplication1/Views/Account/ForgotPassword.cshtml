@model HomeNest.Models.ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5">
        <div class="card border rounded-4 shadow-sm p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 58px; height: 58px; background: rgba(255,56,92,0.1); color: #ff385c;">
                    <i class="bi bi-key-fill fs-2"></i>
                </div>
                <h3 class="fw-bold mt-1 text-dark">Password Recovery</h3>
                <p class="text-muted small">Enter your account email to receive a password reset token</p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small">Email Address *</label>
                    <input asp-for="Email" class="form-control" placeholder="user@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Captcha" class="form-label fw-semibold small">Anti-Bot Verification *</label>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="/Account/CaptchaImage" id="forgotCaptchaImg" alt="Verification Code" 
                             style="height: 42px; border-radius: 8px; cursor: pointer;" 
                             onclick="refreshForgotCaptcha()" title="Click to refresh code" />
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="refreshForgotCaptcha()">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <input asp-for="Captcha" class="form-control" placeholder="Enter characters above" />
                    <span asp-validation-for="Captcha" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-airbnb w-100 py-2 fs-5 fw-bold shadow rounded-pill">
                    Send Password Reset Token
                </button>
            </form>

            <div class="text-center mt-4 border-top pt-3">
                <a asp-action="Login" class="text-danger fw-bold text-decoration-none small"><i class="bi bi-arrow-left"></i> Back to Log In</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function refreshForgotCaptcha() {
            const img = document.getElementById("forgotCaptchaImg");
            if (img) {
                img.src = "/Account/CaptchaImage?t=" + new Date().getTime();
            }
        }
    </script>
}

