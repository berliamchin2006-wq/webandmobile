@model HomeNest.Models.LoginVM
@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5">
        <div class="card border rounded-4 shadow-sm p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 58px; height: 58px; background: rgba(255,56,92,0.1); color: #ff385c;">
                    <i class="bi bi-person-fill-lock fs-2"></i>
                </div>
                <h3 class="fw-bold mt-1 text-dark">Welcome to HomeNest</h3>
                <p class="text-muted small">Log in to book vacation stays or manage your listings</p>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2 small"></div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small">Email Address *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="user@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label fw-semibold small mb-0">Password *</label>
                        <a asp-action="ForgotPassword" class="text-danger small fw-semibold text-decoration-none">Forgot password?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- Anti-bot Verification Code (CAPTCHA) -->
                <div class="mb-3">
                    <label asp-for="Captcha" class="form-label fw-semibold small">Anti-Bot Verification Code *</label>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="/Account/CaptchaImage" id="captchaImg" alt="Verification Code" 
                             style="height: 42px; border-radius: 8px; cursor: pointer;" 
                             onclick="refreshCaptcha()" title="Click image to refresh code" />
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="refreshCaptcha()" title="Refresh code">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-patch-check"></i></span>
                        <input asp-for="Captcha" class="form-control" placeholder="Enter characters above" maxlength="6" />
                    </div>
                    <span asp-validation-for="Captcha" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted">Remember me</label>
                    </div>
                    <small class="text-muted"><i class="bi bi-shield-exclamation text-warning me-1"></i>3-strike lockout active</small>
                </div>

                <button type="submit" class="btn btn-airbnb w-100 py-2 fs-5 fw-bold shadow rounded-pill">
                    Log In
                </button>
            </form>

            <div class="text-center mt-4 border-top pt-3">
                <p class="text-muted small mb-0">Don't have an account? <a asp-action="Register" class="text-danger fw-bold text-decoration-none">Sign up here</a></p>
            </div>

            <div class="card mt-3 bg-light border p-3 small text-muted rounded-4">
                <div class="fw-bold mb-1 text-dark"><i class="bi bi-info-circle me-1"></i> Pre-Seeded Assessment Accounts:</div>
                <div>• Guest: <code>guest1@homenest.my</code> / <code>Password123!</code></div>
                <div>• Host: <code>host1@homenest.my</code> / <code>Password123!</code></div>
                <div>• Admin: <code>admin@homenest.my</code> / <code>Password123!</code></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function refreshCaptcha() {
            const img = document.getElementById("captchaImg");
            if (img) {
                img.src = "/Account/CaptchaImage?t=" + new Date().getTime();
            }
        }
    </script>
}
