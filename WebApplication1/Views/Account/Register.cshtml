@model HomeNest.Models.RegisterVM
@{
    ViewData["Title"] = "Create a HomeNest Account";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6">
        <div class="card border rounded-4 shadow-sm p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 58px; height: 58px; background: rgba(255,56,92,0.1); color: #ff385c;">
                    <i class="bi bi-person-plus-fill fs-2"></i>
                </div>
                <h3 class="fw-bold mt-1 text-dark">Join HomeNest</h3>
                <p class="text-muted small">Create an account to book holiday homes or become a verified host</p>
            </div>

            <form asp-action="Register" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold small">Full Name *</label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. Nurul Aina" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small">Email Address *</label>
                    <input asp-for="Email" class="form-control" placeholder="user@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small">Malaysian Phone *</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="012-3456789" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label fw-semibold small">I want to *</label>
                        <select asp-for="Role" class="form-select">
                            <option value="Guest">Book Vacation Stays (Guest)</option>
                            <option value="Host">Host & List Properties (Host)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold small">Password *</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Min. 8 characters" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Confirm Password *</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Anti-bot Verification Code (CAPTCHA) -->
                <div class="mb-4">
                    <label asp-for="Captcha" class="form-label fw-semibold small">Anti-Bot Verification Code *</label>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="/Account/CaptchaImage" id="regCaptchaImg" alt="Verification Code" 
                             style="height: 42px; border-radius: 8px; cursor: pointer;" 
                             onclick="refreshRegCaptcha()" title="Click to refresh code" />
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="refreshRegCaptcha()" title="Refresh code">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-patch-check"></i></span>
                        <input asp-for="Captcha" class="form-control" placeholder="Enter characters above" maxlength="6" />
                    </div>
                    <span asp-validation-for="Captcha" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-airbnb w-100 py-2 fs-5 fw-bold shadow rounded-pill">
                    Create Account
                </button>
            </form>

            <div class="text-center mt-4 border-top pt-3">
                <p class="text-muted small mb-0">Already registered? <a asp-action="Login" class="text-danger fw-bold text-decoration-none">Log In here</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function refreshRegCaptcha() {
            const img = document.getElementById("regCaptchaImg");
            if (img) {
                img.src = "/Account/CaptchaImage?t=" + new Date().getTime();
            }
        }
    </script>
}
