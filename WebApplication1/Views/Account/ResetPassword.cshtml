@model HomeNest.Models.ResetPasswordVM
@{
    ViewData["Title"] = "Set New Password";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5">
        <div class="card border rounded-4 shadow-sm p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 58px; height: 58px; background: rgba(16,185,129,0.1); color: #10b981;">
                    <i class="bi bi-shield-check fs-2"></i>
                </div>
                <h3 class="fw-bold mt-1 text-dark">Reset Password</h3>
                <p class="text-muted small">Choose a strong new password for <strong>@Model.Email</strong></p>
            </div>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold small">New Password *</label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Min. 8 characters" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Confirm New Password *</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-airbnb w-100 py-2 fs-5 fw-bold shadow rounded-pill">
                    Update Password & Log In
                </button>
            </form>
        </div>
    </div>
</div>

