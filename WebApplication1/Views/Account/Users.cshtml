@model List<HomeNest.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0" style="color: #0f172a;">
                <i class="bi bi-people-fill text-teal me-2"></i>User Management
            </h2>
            <p class="text-muted small">System administration for registered tenants, owners, and administrators</p>
        </div>
        <span class="badge bg-primary px-3 py-2 fs-6">@Model.Count Total User(s)</span>
    </div>

    <div class="table-responsive bg-white rounded-4 shadow-sm p-3 border">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Phone</th>
                    <th>Security / Status</th>
                    <th>Joined</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    bool isLocked = u.LockoutEnd.HasValue && u.LockoutEnd.Value > DateTime.Now;
                    var roleBadge = u.Role switch
                    {
                        "Admin" => "bg-danger",
                        "Owner" => "bg-warning text-dark",
                        _ => "bg-success"
                    };

                    <tr>
                        <td>
                            <div class="fw-bold">@u.FullName</div>
                            <small class="text-muted">@u.Email</small>
                        </td>
                        <td><span class="badge @roleBadge">@u.Role</span></td>
                        <td>@u.PhoneNumber</td>
                        <td>
                            @if (isLocked)
                            {
                                <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Locked Out</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                            }
                        </td>
                        <td>@u.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            @if (isLocked)
                            {
                                <form asp-action="UnlockUser" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-unlock-fill me-1"></i> Unlock
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">Normal</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

