@model HomeNest.Models.PropertyFormVM

@{
    ViewData["Title"] = "Edit Property";
    var amenitiesList = new[] { "WiFi", "AirCond", "NearLRT", "CookingAllowed", "WashingMachine", "WaterHeater", "Refrigerator", "Gym", "SwimmingPool", "Security24Hr", "Balcony" };
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div>
                    <h2 class="fw-bold mb-0">Edit Property Details</h2>
                    <small class="text-muted">Modify property information and amenities</small>
                </div>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small">Listing Title *</label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PropertyType" class="form-label fw-semibold small">Property Type *</label>
                        <select asp-for="PropertyType" class="form-select">
                            <option value="Condominium">Condominium</option>
                            <option value="Apartment">Apartment</option>
                            <option value="Landed House">Landed House</option>
                            <option value="Service Residence">Service Residence</option>
                        </select>
                        <span asp-validation-for="PropertyType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Postcode" class="form-label fw-semibold small">Postcode *</label>
                        <input asp-for="Postcode" class="form-control" required />
                        <span asp-validation-for="Postcode" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold small">Street Address *</label>
                    <input asp-for="Address" class="form-control" required />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-semibold small">City *</label>
                        <input asp-for="City" class="form-control" required />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="State" class="form-label fw-semibold small">State *</label>
                        <select asp-for="State" class="form-select">
                            <option value="Kuala Lumpur">Kuala Lumpur</option>
                            <option value="Selangor">Selangor</option>
                            <option value="Penang">Penang</option>
                            <option value="Johor">Johor</option>
                        </select>
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold small">Description *</label>
                    <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold small d-block">Amenities Available</label>
                    <div class="row row-cols-2 row-cols-md-3 g-2">
                        @foreach (var am in amenitiesList)
                        {
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedAmenities" value="@am" id="am_@am" 
                                           @(Model.SelectedAmenities.Contains(am) ? "checked" : "") />
                                    <label class="form-check-label small" for="am_@am">@am</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="MyProperties" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4" style="background:#0d9488; border-color:#0d9488;">
                        Update Listing
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

