@model HomeNest.Models.Property
@{
    ViewData["Title"] = Model.Title;
    var photos = Model.Photos.OrderBy(ph => ph.DisplayOrder).ToList();
    var coverPhoto = photos.FirstOrDefault(ph => ph.IsCover)?.FileName ?? photos.FirstOrDefault()?.FileName ?? "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80";
    var secondaryPhotos = photos.Where(ph => ph.FileName != coverPhoto).Take(2).ToList();

    double avgRating = Model.Reviews.Any() ? Math.Round(Model.Reviews.Average(r => r.OverallRating), 2) : 5.0;
    int reviewCount = Model.Reviews.Count;

    double avgCleanliness = Model.Reviews.Any() ? Math.Round(Model.Reviews.Average(r => r.CleanlinessRating), 1) : 5.0;
    double avgAccuracy = Model.Reviews.Any() ? Math.Round(Model.Reviews.Average(r => r.AccuracyRating), 1) : 5.0;
    double avgCommunication = Model.Reviews.Any() ? Math.Round(Model.Reviews.Average(r => r.CommunicationRating), 1) : 5.0;
    double avgLocation = Model.Reviews.Any() ? Math.Round(Model.Reviews.Average(r => r.LocationRating), 1) : 5.0;

    var amenitiesList = Model.AmenitiesCsv.Split(',', StringSplitOptions.RemoveEmptyEntries);
}

@section Styles {
    <style>


        .gallery-container {
            border-radius: var(--r-xl);
            overflow: hidden;
            margin-bottom: 36px;
        }

        .gallery-main-frame {
            height: 440px;
            width: 100%;
            overflow: hidden;
            position: relative;
            background: var(--p-surface);
            border-radius: var(--r-lg);
        }
        .gallery-main-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            cursor: pointer;
            transition: transform var(--dur-smooth) var(--ease-standard);
        }
        .gallery-main-frame:hover img {
            transform: scale(1.03);
        }

        .gallery-thumb-frame {
            height: 216px;
            width: 100%;
            overflow: hidden;
            position: relative;
            background: var(--p-surface);
            border-radius: var(--r-lg);
        }
        .gallery-thumb-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            cursor: pointer;
            transition: transform var(--dur-smooth) var(--ease-standard);
        }
        .gallery-thumb-frame:hover img {
            transform: scale(1.03);
        }

        .booking-widget-card {
            border-radius: var(--r-xl);
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--p-line);
            padding: 28px;
            background: var(--p-surface-card);
            position: sticky;
            top: 100px;
            transition: all var(--dur-normal) var(--ease-standard);
        }

        .rating-bar-track {
            height: 6px;
            background: var(--p-line);
            border-radius: 3px;
            overflow: hidden;
            flex-grow: 1;
        }
        .rating-bar-fill {
            height: 100%;
            background: var(--p-ink);
            border-radius: 3px;
        }

        .amenity-chip {
            background: var(--p-surface);
            border: 1px solid var(--p-line);
            border-radius: var(--r-md);
            padding: 12px 18px;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-size: 0.92rem;
            font-weight: 500;
            color: var(--p-ink);
            transition: all var(--dur-quick) var(--ease-standard);
        }
        .amenity-chip:hover {
            border-color: var(--p-muted-light);
            background: var(--p-surface-card);
            transform: translateY(-1px);
        }

        .review-card {
            padding: 20px;
            border: 1px solid var(--p-line);
            border-radius: var(--r-lg);
            background: var(--p-surface);
            height: 100%;
            transition: transform var(--dur-normal) var(--ease-standard),
                        box-shadow var(--dur-normal) var(--ease-standard);
        }
        .review-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }
    </style>
}

<div class="taste-wrap pt-3">
    
    <!-- HEADER -->
    <div class="mb-4">
        <h1 class="fw-bold mb-2 text-dark-emphasis" style="letter-spacing: var(--tracking-tight);">@Model.Title</h1>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2" style="font-size:0.95rem;">
                <span class="fw-bold text-dark-emphasis"><i class="bi bi-star-fill text-warning"></i> @(reviewCount > 0 ? avgRating.ToString("0.0") : "New")</span>
                <span class="text-muted">·</span>
                <a href="#reviewsSection" class="text-dark-emphasis fw-semibold text-decoration-underline">@(reviewCount) reviews</a>
                @if (ViewBag.IsSuperhost == true)
                {
                    <span class="text-muted">·</span>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1">
                        <i class="bi bi-award-fill"></i> Superhost
                    </span>
                }
                <span class="text-muted">·</span>
                <span class="text-muted"><i class="bi bi-geo-alt-fill text-danger"></i> @Model.Address, @Model.City, @Model.State</span>
            </div>

            <!-- Save to Wishlist Button -->
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-taste rounded-pill px-3 py-1 btn-wishlist-toggle" data-property-id="@Model.Id">
                    <i class="bi @(ViewBag.IsSavedToWishlist == true ? "bi-heart-fill text-danger" : "bi-heart")" id="wishlistIcon"></i>
                    <span id="wishlistText">@(ViewBag.IsSavedToWishlist == true ? "Saved" : "Save")</span>
                </button>
            </div>
        </div>
    </div>

    <!-- AIRBNB PHOTO GALLERY (House Rule 5 Micro-Zoom) -->
    <div class="row g-2 gallery-container">
        <div class="col-12 col-md-8">
            <div class="gallery-main-frame">
                <img src="@coverPhoto" alt="@Model.Title" />
            </div>
        </div>
        <div class="col-12 col-md-4 d-flex flex-column gap-2">
            @if (secondaryPhotos.Any())
            {
                foreach (var ph in secondaryPhotos)
                {
                    <div class="gallery-thumb-frame">
                        <img src="@ph.FileName" alt="Interior View" />
                    </div>
                }
            }
            else
            {
                <div class="gallery-thumb-frame">
                    <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=800&q=80" alt="Living Room" />
                </div>
                <div class="gallery-thumb-frame">
                    <img src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?w=800&q=80" alt="Bedroom Suite" />
                </div>
            }
        </div>
    </div>

    <!-- MAIN TWO COLUMN SECTION -->
    <div class="row g-5">
        
        <!-- LEFT COLUMN: PROPERTY DETAILS, HOST, AMENITIES, REVIEWS -->
        <div class="col-12 col-lg-8">
            
            <!-- Space Overview & Host Card -->
            <div class="d-flex justify-content-between align-items-center pb-4 border-bottom" style="border-color: var(--p-line) !important;">
                <div>
                    <h3 class="fw-bold mb-1 text-dark-emphasis">Entire @Model.PropertyType hosted by @Model.Host.FullName</h3>
                    <p class="text-muted mb-0" style="font-size:0.95rem;">
                        @Model.MaxGuests guests · @Model.Bedrooms bedrooms · @Model.Beds beds · @Model.Bathrooms bathrooms
                    </p>
                </div>
                <div class="text-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-1 shadow-sm" style="width:52px; height:52px; font-weight:800; font-size:1.15rem; background: linear-gradient(135deg, var(--p-accent) 0%, #e11d48 100%); color:#ffffff;">
                        @(Model.Host.FullName.Length > 0 ? Model.Host.FullName[0].ToString().ToUpper() : "H")
                    </div>
                    @if (Model.Host.IdentityStatus == "Verified")
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size:0.7rem;">
                            <i class="bi bi-patch-check-fill"></i> Verified Host
                        </span>
                    }
                </div>
            </div>

            <!-- Key Highlights -->
            <div class="py-4 border-bottom d-flex flex-column gap-3" style="border-color: var(--p-line) !important;">
                <div class="d-flex gap-3 align-items-start">
                    <i class="bi bi-door-open fs-3 text-dark-emphasis"></i>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark-emphasis">Self check-in</h6>
                        <small class="text-muted">Check in smoothly with electronic smart lock & digital QR pass.</small>
                    </div>
                </div>
                @if (ViewBag.IsSuperhost == true)
                {
                    <div class="d-flex gap-3 align-items-start">
                        <i class="bi bi-award fs-3 text-warning"></i>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark-emphasis">@Model.Host.FullName is a Superhost</h6>
                            <small class="text-muted">Superhosts are experienced, highly rated hosts who are committed to providing great stays for guests.</small>
                        </div>
                    </div>
                }
                <div class="d-flex gap-3 align-items-start">
                    <i class="bi bi-shield-check fs-3 text-success"></i>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark-emphasis">Cancellation Policy: @Model.CancellationPolicy</h6>
                        <small class="text-muted">
                            @if (Model.CancellationPolicy == "Flexible")
                            {
                                <span>Full refund up to 24 hours before check-in. 50% refund afterwards.</span>
                            }
                            else if (Model.CancellationPolicy == "Moderate")
                            {
                                <span>Full refund up to 5 days before check-in. 50% refund afterwards.</span>
                            }
                            else
                            {
                                <span>50% refund up to 7 days before check-in. Non-refundable afterwards.</span>
                            }
                        </small>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="py-4 border-bottom" style="border-color: var(--p-line) !important;">
                <h4 class="fw-bold mb-3 text-dark-emphasis">About this space</h4>
                <p class="text-muted" style="line-height:1.75; white-space:pre-line; font-size:0.95rem;">@Model.Description</p>
            </div>

            <!-- Amenities -->
            <div class="py-4 border-bottom" style="border-color: var(--p-line) !important;">
                <h4 class="fw-bold mb-3 text-dark-emphasis">What this place offers</h4>
                <div class="row g-3">
                    @foreach (var am in amenitiesList)
                    {
                        string icon = am switch
                        {
                            "WiFi" => "bi-wifi",
                            "AirCond" => "bi-snow",
                            "Kitchen" => "bi-cup-hot",
                            "Pool" => "bi-water",
                            "FreeParking" => "bi-car-front",
                            "TV" => "bi-tv",
                            "Gym" => "bi-activity",
                            "SeaView" => "bi-water",
                            "SelfCheckIn" => "bi-key",
                            _ => "bi-check-circle"
                        };
                        <div class="col-6 col-md-4">
                            <div class="amenity-chip w-100">
                                <i class="bi @icon fs-5 text-dark-emphasis"></i>
                                <span>@am</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- House Rules -->
            <div class="py-4 border-bottom" style="border-color: var(--p-line) !important;">
                <h4 class="fw-bold mb-3 text-dark-emphasis">House rules</h4>
                <div class="p-3 bg-surface rounded-4 border" style="background: var(--p-surface); border-color: var(--p-line) !important; border-radius: var(--r-md) !important;">
                    <p class="mb-0 text-muted" style="line-height:1.6; font-size:0.92rem;">@Model.HouseRules</p>
                </div>
            </div>

            <!-- Interactive Map Location -->
            <div class="py-4 border-bottom" style="border-color: var(--p-line) !important;">
                <h4 class="fw-bold mb-2 text-dark-emphasis">Where you'll be</h4>
                <p class="text-muted mb-3"><i class="bi bi-geo-alt-fill text-danger"></i> @Model.Address, @Model.City, @Model.State, @Model.Postcode</p>
                <div id="detailsMap" style="height:320px; border-radius:var(--r-lg); overflow:hidden;" class="border"></div>
            </div>

            <!-- REVIEWS SECTION -->
            <div class="py-5" id="reviewsSection">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-star-fill text-warning fs-4"></i>
                    <h3 class="fw-bold mb-0 text-dark-emphasis">@(reviewCount > 0 ? avgRating.ToString("0.0") : "No reviews yet") · @reviewCount reviews</h3>
                </div>

                <!-- Multi-Criteria Rating Breakdown Bars -->
                @if (reviewCount > 0)
                {
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-semibold text-dark-emphasis" style="width:120px; font-size:0.88rem;">Cleanliness</span>
                                <div class="rating-bar-track">
                                    <div class="rating-bar-fill" style="width: @(avgCleanliness * 20)%"></div>
                                </div>
                                <span class="fw-bold text-dark-emphasis" style="font-size:0.85rem;">@avgCleanliness</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-semibold text-dark-emphasis" style="width:120px; font-size:0.88rem;">Accuracy</span>
                                <div class="rating-bar-track">
                                    <div class="rating-bar-fill" style="width: @(avgAccuracy * 20)%"></div>
                                </div>
                                <span class="fw-bold text-dark-emphasis" style="font-size:0.85rem;">@avgAccuracy</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-semibold text-dark-emphasis" style="width:120px; font-size:0.88rem;">Communication</span>
                                <div class="rating-bar-track">
                                    <div class="rating-bar-fill" style="width: @(avgCommunication * 20)%"></div>
                                </div>
                                <span class="fw-bold text-dark-emphasis" style="font-size:0.85rem;">@avgCommunication</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-semibold text-dark-emphasis" style="width:120px; font-size:0.88rem;">Location</span>
                                <div class="rating-bar-track">
                                    <div class="rating-bar-fill" style="width: @(avgLocation * 20)%"></div>
                                </div>
                                <span class="fw-bold text-dark-emphasis" style="font-size:0.85rem;">@avgLocation</span>
                            </div>
                        </div>
                    </div>
                }

                <!-- Review Items List -->
                <div class="row g-4">
                    @foreach (var rev in Model.Reviews.Where(r => r.IsPublished).OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="col-12 col-md-6">
                            <div class="review-card">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center shadow-xs" style="width:38px; height:38px; font-weight:700;">
                                        @(rev.Guest?.FullName?.Length > 0 ? rev.Guest.FullName[0].ToString().ToUpper() : "G")
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark-emphasis" style="font-size:0.9rem;">@rev.Guest?.FullName</h6>
                                        <small class="text-muted">@rev.CreatedAt.ToString("MMM yyyy")</small>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <i class="bi @(s <= rev.OverallRating ? "bi-star-fill text-warning" : "bi-star text-muted")" style="font-size:0.75rem;"></i>
                                    }
                                </div>

                                <p class="text-muted mb-3" style="font-size:0.88rem; line-height:1.55;">@rev.Comment</p>

                                @if (!string.IsNullOrEmpty(rev.HostReply))
                                {
                                    <div class="p-2 border-start border-3 border-danger bg-surface rounded mb-2" style="font-size:0.82rem; background: var(--p-surface-card);">
                                        <strong>Host response:</strong> @rev.HostReply
                                    </div>
                                }

                                <!-- Helpful Thumbs-Up Button -->
                                <button type="button" class="btn btn-sm btn-secondary-taste rounded-pill btn-helpful" data-review-id="@rev.Id" style="font-size:0.75rem;">
                                    <i class="bi bi-hand-thumbs-up"></i> Helpful (<span class="helpful-count-@rev.Id">@rev.HelpfulVotes</span>)
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: INTERACTIVE RESERVATION WIDGET -->
        <div class="col-12 col-lg-4">
            <div class="booking-widget-card">
                
                <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <div>
                        <span class="fs-3 fw-bolder text-dark-emphasis" data-base-price="@Model.BaseNightlyRate">RM @Model.BaseNightlyRate.ToString("N0")</span>
                        <span class="text-muted" style="font-size:0.9rem;"> / night</span>
                    </div>
                    <div class="text-end">
                        <span class="fw-bold text-dark-emphasis"><i class="bi bi-star-fill text-warning"></i> @(reviewCount > 0 ? avgRating.ToString("0.0") : "New")</span>
                        <span class="text-muted" style="font-size:0.82rem;">(@reviewCount reviews)</span>
                    </div>
                </div>

                <!-- DATE PICKER & GUESTS INPUTS -->
                <form id="reservationForm" method="get" asp-controller="Booking" asp-action="Checkout">
                    <input type="hidden" name="propertyId" value="@Model.Id" />

                    <div class="border rounded-3 p-2 mb-3 bg-surface" style="background: var(--p-surface); border-color: var(--p-line) !important; border-radius: var(--r-md) !important;">
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="fw-bold text-uppercase text-muted" style="font-size:0.65rem; letter-spacing:0.04em;">Check-in</label>
                                <input type="date" id="widgetCheckIn" name="checkIn" class="form-control form-control-sm border-0 bg-transparent fw-semibold text-dark-emphasis" value="@ViewBag.CheckIn" />
                            </div>
                            <div class="col-6 border-start" style="border-color: var(--p-line) !important;">
                                <label class="fw-bold text-uppercase text-muted" style="font-size:0.65rem; letter-spacing:0.04em;">Check-out</label>
                                <input type="date" id="widgetCheckOut" name="checkOut" class="form-control form-control-sm border-0 bg-transparent fw-semibold text-dark-emphasis" value="@ViewBag.CheckOut" />
                            </div>
                        </div>
                        <div class="border-top pt-2" style="border-color: var(--p-line) !important;">
                            <label class="fw-bold text-uppercase text-muted" style="font-size:0.65rem; letter-spacing:0.04em;">Guests</label>
                            <select id="widgetGuests" name="guests" class="form-select form-select-sm border-0 bg-transparent fw-semibold text-dark-emphasis">
                                @for (int g = 1; g <= Model.MaxGuests; g++)
                                {
                                    <option value="@g" selected="@(g == ViewBag.Guests)">@g guest@(g > 1 ? "s" : "")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Availability Alert Status -->
                    <div id="availabilityAlert" class="taste-alert taste-alert-danger py-2 px-3 d-none mb-3" style="font-size:0.85rem;">
                        <i class="bi bi-exclamation-circle-fill me-1"></i> <span id="availabilityMsg">Dates unavailable</span>
                    </div>

                    <!-- Reserve Now Button -->
                    <button type="submit" id="btnReserve" class="btn btn-airbnb w-100 py-3 fs-5 fw-bold">
                        Reserve Now
                    </button>
                    <p class="text-center text-muted mt-2 mb-3" style="font-size:0.8rem;">You won't be charged yet</p>

                    <!-- AUTOMATED PRICE BREAKDOWN -->
                    <div id="priceBreakdownContainer" class="border-top pt-3" style="border-color: var(--p-line) !important;">
                        <div class="d-flex justify-content-between mb-2" style="font-size:0.9rem;">
                            <span class="text-muted" id="nightCalcLabel">RM @Model.BaseNightlyRate × @ViewBag.Nights nights</span>
                            <span class="fw-semibold text-dark-emphasis" id="subtotalDisplay" data-base-price="@ViewBag.Subtotal">RM @ViewBag.Subtotal.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2" style="font-size:0.9rem;">
                            <span class="text-muted">Cleaning fee</span>
                            <span class="fw-semibold text-dark-emphasis" id="cleaningDisplay" data-base-price="@ViewBag.CleaningFee">RM @ViewBag.CleaningFee.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2" style="font-size:0.9rem;">
                            <span class="text-muted">HomeNest service fee (10%)</span>
                            <span class="fw-semibold text-dark-emphasis" id="serviceDisplay" data-base-price="@ViewBag.ServiceFee">RM @ViewBag.ServiceFee.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between pt-3 border-top fw-bold fs-5 text-dark-emphasis" style="border-color: var(--p-line) !important;">
                            <span>Total before taxes</span>
                            <span id="totalDisplay" class="text-danger" data-base-price="@ViewBag.Total">RM @ViewBag.Total.ToString("N0")</span>
                        </div>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // 1. Details Map
        const map = L.map('detailsMap').setView([@Model.Latitude, @Model.Longitude], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        L.circle([@Model.Latitude, @Model.Longitude], {
            color: '#ff385c',
            fillColor: '#ff385c',
            fillOpacity: 0.22,
            radius: 350
        }).addTo(map);

        const detailsIcon = L.divIcon({
            className: 'custom-price-pin-wrapper',
            html: `<div class="custom-price-pin active">RM @Math.Round(Model.BaseNightlyRate)</div>`,
            iconSize: [80, 32],
            iconAnchor: [40, 16]
        });

        L.marker([@Model.Latitude, @Model.Longitude], { icon: detailsIcon })
            .bindPopup("<b>@Html.Raw(Model.Title.Replace("\"", "\\\""))</b><br>@Model.Address")
            .addTo(map);

        // 2. Real-Time Price Breakdown & Availability Checker
        const propId = @Model.Id;
        const checkInInput = document.getElementById('widgetCheckIn');
        const checkOutInput = document.getElementById('widgetCheckOut');
        const guestsInput = document.getElementById('widgetGuests');
        const btnReserve = document.getElementById('btnReserve');
        const alertBox = document.getElementById('availabilityAlert');
        const alertMsg = document.getElementById('availabilityMsg');

        function updatePriceCalculator() {
            const cIn = checkInInput.value;
            const cOut = checkOutInput.value;
            const g = guestsInput.value;

            if (!cIn || !cOut || cOut <= cIn) {
                alertBox.classList.remove('d-none');
                alertMsg.textContent = 'Check-out date must be after check-in date.';
                btnReserve.disabled = true;
                return;
            }

            $.ajax({
                url: '/Property/CheckAvailability',
                type: 'GET',
                data: { propertyId: propId, checkIn: cIn, checkOut: cOut, guests: g },
                success: function(res) {
                    if (res.available) {
                        alertBox.classList.add('d-none');
                        btnReserve.disabled = false;

                        $('#nightCalcLabel').text(`RM ${res.subtotal / res.nights} × ${res.nights} nights`);
                        $('#subtotalDisplay').text(`RM ${Math.round(res.subtotal)}`).attr('data-base-price', res.subtotal);
                        $('#cleaningDisplay').text(`RM ${Math.round(res.cleaningFee)}`).attr('data-base-price', res.cleaningFee);
                        $('#serviceDisplay').text(`RM ${Math.round(res.serviceFee)}`).attr('data-base-price', res.serviceFee);
                        $('#totalDisplay').text(`RM ${Math.round(res.total)}`).attr('data-base-price', res.total);
                    } else {
                        alertBox.classList.remove('d-none');
                        alertMsg.textContent = res.message || 'These dates are booked or unavailable.';
                        btnReserve.disabled = true;
                    }
                }
            });
        }

        checkInInput.addEventListener('change', updatePriceCalculator);
        checkOutInput.addEventListener('change', updatePriceCalculator);
        guestsInput.addEventListener('change', updatePriceCalculator);

        // 3. Wishlist Toggle Button
        $('.btn-wishlist-toggle').on('click', function() {
            const pId = $(this).data('property-id');
            const icon = $('#wishlistIcon');
            const txt = $('#wishlistText');

            $.ajax({
                url: '/Property/ToggleWishlist',
                type: 'POST',
                data: { propertyId: pId },
                success: function(res) {
                    if (res.success) {
                        if (res.isSaved) {
                            icon.removeClass('bi-heart').addClass('bi-heart-fill text-danger');
                            txt.text('Saved');
                        } else {
                            icon.removeClass('bi-heart-fill text-danger').addClass('bi-heart');
                            txt.text('Save');
                        }
                    }
                },
                error: function(xhr) {
                    if (xhr.status === 401) {
                        window.location.href = '/Account/Login?returnUrl=/Property/Details/' + pId;
                    }
                }
            });
        });

        // 4. Helpful Vote Button
        $('.btn-helpful').on('click', function() {
            const btn = $(this);
            const reviewId = btn.data('review-id');

            $.ajax({
                url: '/Booking/VoteReviewHelpful',
                type: 'POST',
                data: { reviewId: reviewId },
                success: function(res) {
                    if (res.success) {
                        $(`.helpful-count-${reviewId}`).text(res.helpfulCount);
                        btn.addClass('btn-secondary text-white').removeClass('btn-secondary-taste');
                    }
                }
            });
        });
    </script>
}
