@model Dictionary<string, List<HomeNest.Models.Wishlist>>
@{
    ViewData["Title"] = "My Wishlists & Trip Folders";
}

<div class="taste-wrap py-4">
    
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-3 py-1 mb-2 font-monospace" style="font-size:0.75rem;">
                <i class="bi bi-heart-fill me-1"></i> Trip Collections
            </span>
            <h2 class="fw-bold mb-1 text-dark-emphasis" style="letter-spacing: var(--tracking-tight);">Saved Homes & Trip Collections</h2>
            <p class="text-muted small mb-0">Organize and revisit your dream stays across Malaysia</p>
        </div>
        <a asp-action="Catalog" class="btn btn-outline-taste rounded-pill px-4">
            <i class="bi bi-compass me-1"></i> Explore More Stays
        </a>
    </div>

    @if (!Model.Any() || Model.All(g => !g.Value.Any()))
    {
        <div class="text-center py-5 border rounded-4 bg-surface shadow-sm" style="border-radius: var(--r-xl) !important; background: var(--p-surface); border-color: var(--p-line) !important;">
            <i class="bi bi-heart fs-1 text-danger"></i>
            <h4 class="mt-3 fw-bold text-dark-emphasis">Your wishlist is empty</h4>
            <p class="text-muted" style="font-size:0.92rem;">As you search, tap the heart icon on any property to save your favorite stays and plan your trips.</p>
            <a asp-action="Catalog" class="btn btn-airbnb rounded-pill px-4 mt-2">Start Exploring</a>
        </div>
    }
    else
    {
        @foreach (var folder in Model)
        {
            <div class="mb-5">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-folder-fill fs-4 text-warning"></i>
                    <h4 class="fw-bold mb-0 text-dark-emphasis">@folder.Key</h4>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill">@folder.Value.Count stay@(folder.Value.Count > 1 ? "s" : "")</span>
                </div>

                <div class="row g-4">
                    @foreach (var item in folder.Value)
                    {
                        var p = item.Property;
                        var cover = p.Photos.FirstOrDefault(ph => ph.IsCover)?.FileName 
                            ?? p.Photos.FirstOrDefault()?.FileName 
                            ?? "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80";

                        double avgRating = p.Reviews.Any() ? Math.Round(p.Reviews.Average(r => r.OverallRating), 1) : 5.0;

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card-custom h-100 position-relative">
                                
                                <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">
                                    <div class="taste-photo-frame" style="height: 200px;">
                                        <img src="@cover" alt="@p.Title" />
                                        <span class="taste-type-badge">
                                            @p.PropertyType
                                        </span>
                                    </div>
                                </a>

                                <div class="p-3 d-flex flex-column justify-content-between flex-grow-1">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                                            <span class="fw-bold text-dark-emphasis text-truncate" style="max-width:70%; font-size:0.95rem;">@p.City, @p.State</span>
                                            <span class="fw-semibold text-dark-emphasis" style="font-size:0.86rem;"><i class="bi bi-star-fill text-warning"></i> @avgRating</span>
                                        </div>

                                        <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">
                                            <p class="text-muted mb-2 text-truncate" style="font-size:0.88rem;" title="@p.Title">@p.Title</p>
                                        </a>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color: var(--p-line) !important;">
                                        <div>
                                            <strong class="fs-5 text-dark-emphasis" data-base-price="@p.BaseNightlyRate">RM @p.BaseNightlyRate.ToString("N0")</strong>
                                            <span class="text-muted" style="font-size:0.8rem;"> / night</span>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-taste rounded-pill px-3">
                                                View Stay
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-circle btn-remove-wishlist d-flex align-items-center justify-content-center" data-property-id="@p.Id" title="Remove from Wishlist" style="width:34px; height:34px;">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }

</div>

@section Scripts {
    <script>
        $('.btn-remove-wishlist').on('click', function() {
            const pId = $(this).data('property-id');
            const card = $(this).closest('.col-12');

            $.ajax({
                url: '/Property/ToggleWishlist',
                type: 'POST',
                data: { propertyId: pId },
                success: function(res) {
                    if (res.success && !res.isSaved) {
                        card.fadeOut(300, function() { $(this).remove(); });
                    }
                }
            });
        });
    </script>
}
