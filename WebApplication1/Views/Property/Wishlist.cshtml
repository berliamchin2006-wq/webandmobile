@model Dictionary<string, List<HomeNest.Models.Wishlist>>
@{
    ViewData["Title"] = "My Wishlists & Trip Folders";
}

<div class="container py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-danger bg-opacity-75 rounded-pill px-3 py-1 mb-1">[Additional Feature] Guest Wishlist with Trip Folders</span>
            <h2 class="fw-bold mb-0">Saved Homes & Trip Collections</h2>
        </div>
        <a asp-action="Catalog" class="btn btn-outline-dark rounded-pill px-4">
            <i class="bi bi-compass"></i> Explore Stays
        </a>
    </div>

    @if (!Model.Any() || Model.All(g => !g.Value.Any()))
    {
        <div class="text-center py-5 border rounded-4 bg-light">
            <i class="bi bi-heart fs-1 text-danger"></i>
            <h4 class="mt-3 fw-bold">Your wishlist is empty</h4>
            <p class="text-muted">As you search, tap the heart icon on any property to save your favorite stays and plan your trips.</p>
            <a asp-action="Catalog" class="btn btn-airbnb rounded-pill px-4 mt-2">Start Exploring</a>
        </div>
    }
    else
    {
        @foreach (var folder in Model)
        {
            <div class="mb-5">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-folder-fill fs-4 text-warning"></i>
                    <h4 class="fw-bold mb-0">@folder.Key</h4>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill">@folder.Value.Count stay@(folder.Value.Count > 1 ? "s" : "")</span>
                </div>

                <div class="row g-4">
                    @foreach (var item in folder.Value)
                    {
                        var p = item.Property;
                        var cover = p.Photos.FirstOrDefault(ph => ph.IsCover)?.FileName 
                            ?? p.Photos.FirstOrDefault()?.FileName 
                            ?? "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80";

                        double avgRating = p.Reviews.Any() ? Math.Round(p.Reviews.Average(r => r.OverallRating), 1) : 5.0;

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 border rounded-4 shadow-sm overflow-hidden position-relative">
                                
                                <div style="height: 200px; overflow: hidden;">
                                    <img src="@cover" class="w-100 h-100 object-fit-cover" />
                                </div>

                                <div class="p-3">
                                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                                        <span class="fw-bold text-dark text-truncate" style="max-width:70%;">@p.City, @p.State</span>
                                        <span class="fw-semibold text-dark" style="font-size:0.85rem;"><i class="bi bi-star-fill text-warning"></i> @avgRating</span>
                                    </div>

                                    <h6 class="fw-normal text-muted mb-2 text-truncate" title="@p.Title">@p.Title</h6>

                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <div>
                                            <strong class="fs-5 text-dark" data-base-price="@p.BaseNightlyRate">RM @p.BaseNightlyRate.ToString("N0")</strong>
                                            <span class="text-muted" style="font-size:0.8rem;"> / night</span>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                                View
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-circle btn-remove-wishlist" data-property-id="@p.Id" title="Remove from Wishlist">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }

</div>

@section Scripts {
    <script>
        $('.btn-remove-wishlist').on('click', function() {
            const pId = $(this).data('property-id');
            const card = $(this).closest('.col-12');

            $.ajax({
                url: '/Property/ToggleWishlist',
                type: 'POST',
                data: { propertyId: pId },
                success: function(res) {
                    if (res.success && !res.isSaved) {
                        card.fadeOut(300, function() { $(this).remove(); });
                    }
                }
            });
        });
    </script>
}

