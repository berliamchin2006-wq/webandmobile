@model List<HomeNest.Models.Property>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4" id="propertiesList">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="card border-0 shadow-sm p-5 text-center">
                <i class="bi bi-search text-muted display-4 mb-3"></i>
                <h4 class="fw-bold">No properties match your filter</h4>
                <p class="text-muted">Try resetting your search query or adjusting the max rent slider.</p>
                <div class="mt-2">
                    <a asp-action="Catalog" class="btn btn-outline-primary btn-sm">Reset All Filters</a>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            var photoObj = item.Photos.FirstOrDefault(p => p.IsCover) ?? item.Photos.FirstOrDefault();
            string imgUrl = photoObj?.FileName ?? "";
            if (string.IsNullOrEmpty(imgUrl))
            {
                imgUrl = "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800";
            }
            else if (!imgUrl.StartsWith("http") && !imgUrl.StartsWith("/"))
            {
                imgUrl = "/uploads/properties/" + imgUrl;
            }

            var minRent = item.RoomUnits.Any() ? item.RoomUnits.Min(r => r.MonthlyRent) : 0m;
            var availableRooms = item.RoomUnits.Count(r => r.IsAvailable);
            var amenities = (item.AmenitiesCsv ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            <div class="col property-item" 
                 data-city="@item.City" 
                 data-lat="@item.Latitude" 
                 data-lng="@item.Longitude" 
                 data-id="@item.Id">
                <div class="card h-100 property-card-modern shadow-sm border-0">
                    <!-- Photo with Badges -->
                    <div class="position-relative bg-light" style="height: 185px; overflow: hidden;">
                        <img src="@imgUrl" class="card-img-top w-100 h-100" style="object-fit: cover; transition: transform 0.3s ease;" alt="@item.Title" onerror="this.src='https://placehold.co/600x400/e2e8f0/334155?text=HomeNest';" />
                        
                        <div class="position-absolute top-0 start-0 m-2">
                            <span class="badge bg-dark bg-opacity-75 text-white fw-semibold px-2 py-1" style="font-size: 10px; backdrop-filter: blur(4px);">
                                <i class="bi bi-patch-check-fill text-info me-1"></i> Verified Landlord
                            </span>
                        </div>

                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge bg-white text-dark shadow-sm fw-bold px-2 py-1" style="font-size: 10px;">
                                @item.PropertyType
                            </span>
                        </div>

                        <div class="position-absolute bottom-0 end-0 m-2">
                            <span class="badge @(availableRooms > 0 ? "bg-success" : "bg-danger") shadow-sm" style="font-size: 10px;">
                                @(availableRooms > 0 ? $"{availableRooms} Room(s) Left" : "Fully Occupied")
                            </span>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body d-flex flex-column p-3">
                        <h6 class="card-title fw-bold text-truncate mb-1" title="@item.Title" style="font-size: 0.95rem;">
                            @item.Title
                        </h6>
                        
                        <p class="card-text text-muted small mb-2 text-truncate">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i> @item.City, @item.State
                        </p>

                        <!-- Amenities Pills -->
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @if (amenities.Contains("WiFi"))
                            {
                                <span class="badge bg-light text-secondary border" style="font-size: 9.5px;">📶 WiFi</span>
                            }
                            @if (amenities.Contains("AirCond"))
                            {
                                <span class="badge bg-light text-secondary border" style="font-size: 9.5px;">❄️ Air-Cond</span>
                            }
                            @if (amenities.Contains("NearLRT"))
                            {
                                <span class="badge bg-light text-secondary border" style="font-size: 9.5px;">🚇 Near LRT</span>
                            }
                            @if (amenities.Contains("CookingAllowed"))
                            {
                                <span class="badge bg-light text-secondary border" style="font-size: 9.5px;">🍳 Cooking</span>
                            }
                        </div>

                        <!-- Price & CTA -->
                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block" style="font-size: 10.5px;">From</small>
                                <span class="fw-bold fs-6" style="color: #0d9488;">RM @minRent.ToString("N0")</span>
                                <small class="text-muted" style="font-size: 11px;">/mo</small>
                            </div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary fw-semibold px-3 py-1" style="border-radius: 8px; font-size: 12px;">
                                View Rooms <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
