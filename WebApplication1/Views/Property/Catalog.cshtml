@model List<HomeNest.Models.Property>
@{
    ViewData["Title"] = "Find Holiday Homes & Vacation Rentals";
    string[] selectedAmenities = ViewBag.SelectedAmenities as string[] ?? Array.Empty<string>();
}

@section Styles {
    <style>
        .search-hero {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            border-radius: 24px;
            padding: 32px 28px;
            color: white;
            margin-bottom: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
        }

        .search-box {
            background: white;
            border-radius: 18px;
            padding: 18px 24px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
            color: #222;
        }

        .search-input-group {
            border-right: 1px solid #ebebeb;
            padding: 0 16px;
        }
        .search-input-group:last-child {
            border-right: none;
        }

        .search-label {
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #222;
            margin-bottom: 2px;
            display: block;
        }

        .search-input {
            border: none;
            outline: none;
            font-size: 0.92rem;
            width: 100%;
            background: transparent;
            color: #444;
            font-weight: 500;
        }

        /* Leaflet custom map markers */
        .custom-price-pin {
            background: white;
            color: #222;
            font-weight: 800;
            font-size: 0.85rem;
            padding: 4px 10px;
            border-radius: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.25);
            border: 1px solid rgba(0,0,0,0.1);
            text-align: center;
            white-space: nowrap;
            transition: all 0.2s;
            cursor: pointer;
        }
        .custom-price-pin:hover {
            background: #222;
            color: white;
            transform: scale(1.1);
        }

        .area-chip {
            background: rgba(255,255,255,0.15);
            color: white;
            border: 1px solid rgba(255,255,255,0.25);
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
        }
        .area-chip:hover {
            background: white;
            color: #0f172a;
        }

        #mapContainer {
            height: 380px;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            margin-bottom: 28px;
            display: block;
        }
    </style>
}

<div class="container-fluid px-lg-5 pt-3">
    
    <!-- SEARCH HERO BAR -->
    <div class="search-hero">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div>
                <span class="badge bg-danger bg-opacity-75 rounded-pill px-3 py-1 mb-2">
                    <i class="bi bi-shield-check"></i> TAR UMT BMIT2023 Showcase Platform
                </span>
                <h2 class="fw-bold mb-1">Find Vacation Homes & Staycations in Malaysia</h2>
                <p class="text-white-50 mb-0" style="font-size:0.95rem;">
                    Instant booking confirmation, verified superhosts, real-time availability calendar, and QR check-in passes.
                </p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <button type="button" id="btnToggleMap" class="btn btn-outline-light rounded-pill px-3">
                    <i class="bi bi-map"></i> <span id="mapToggleText">Hide Map</span>
                </button>
            </div>
        </div>

        <!-- MAIN SEARCH FORM -->
        <form id="searchForm" class="search-box">
            <div class="row g-3 align-items-center">
                
                <!-- Where -->
                <div class="col-12 col-md-3 search-input-group">
                    <label class="search-label"><i class="bi bi-geo-alt"></i> Where</label>
                    <input type="text" name="keyword" id="inputKeyword" class="search-input" 
                           placeholder="KLCC, Penang, Cameron, Sunway..." value="@ViewBag.Keyword" />
                </div>

                <!-- Check-in & Check-out Dates -->
                <div class="col-6 col-md-2 search-input-group">
                    <label class="search-label"><i class="bi bi-calendar-check"></i> Check In</label>
                    <input type="date" name="checkIn" id="inputCheckIn" class="search-input" value="@ViewBag.CheckIn" />
                </div>

                <div class="col-6 col-md-2 search-input-group">
                    <label class="search-label"><i class="bi bi-calendar-x"></i> Check Out</label>
                    <input type="date" name="checkOut" id="inputCheckOut" class="search-input" value="@ViewBag.CheckOut" />
                </div>

                <!-- Guests -->
                <div class="col-6 col-md-2 search-input-group">
                    <label class="search-label"><i class="bi bi-people"></i> Who</label>
                    <select name="guests" id="selectGuests" class="search-input">
                        <option value="1" selected="@(ViewBag.Guests == 1)">1 Guest</option>
                        <option value="2" selected="@(ViewBag.Guests == 2)">2 Guests</option>
                        <option value="4" selected="@(ViewBag.Guests == 4)">4+ Guests</option>
                        <option value="6" selected="@(ViewBag.Guests == 6)">6+ Guests</option>
                        <option value="8" selected="@(ViewBag.Guests == 8)">8+ Large Group</option>
                    </select>
                </div>

                <!-- Property Type & Submit -->
                <div class="col-6 col-md-3 d-flex align-items-center gap-2">
                    <div class="flex-grow-1">
                        <label class="search-label"><i class="bi bi-building"></i> Type</label>
                        <select name="propertyType" id="selectType" class="search-input">
                            <option value="All">All Types</option>
                            <option value="Condominium" selected="@(ViewBag.PropertyType == "Condominium")">Condo</option>
                            <option value="Villa" selected="@(ViewBag.PropertyType == "Villa")">Villa</option>
                            <option value="Townhouse" selected="@(ViewBag.PropertyType == "Townhouse")">Townhouse</option>
                            <option value="Chalet" selected="@(ViewBag.PropertyType == "Chalet")">Chalet</option>
                            <option value="Studio" selected="@(ViewBag.PropertyType == "Studio")">Studio</option>
                        </select>
                    </div>
                    <button type="button" id="btnLiveSearch" class="btn btn-airbnb rounded-circle p-3 d-flex align-items-center justify-content-center shadow-sm" style="width:48px; height:48px;">
                        <i class="bi bi-search fs-5"></i>
                    </button>
                </div>
            </div>

            <!-- Expandable Amenities & Price Slider Filter Bar -->
            <div class="row g-3 align-items-center mt-2 pt-2 border-top">
                <div class="col-md-5">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="search-label mb-0"><i class="bi bi-sliders"></i> Nightly Price Range</span>
                        <span class="fw-bold text-dark" style="font-size:0.85rem;" id="priceDisplay">Up to RM @ViewBag.MaxPrice</span>
                    </div>
                    <input type="range" class="form-range" id="priceRange" min="50" max="1500" step="25" value="@ViewBag.MaxPrice" />
                    <input type="hidden" name="maxPrice" id="inputMaxPrice" value="@ViewBag.MaxPrice" />
                </div>

                <div class="col-md-5">
                    <span class="search-label mb-1"><i class="bi bi-check2-square"></i> Popular Amenities</span>
                    <div class="d-flex flex-wrap gap-2" style="font-size:0.8rem;">
                        <label class="form-check-label me-2">
                            <input type="checkbox" name="amenities" value="WiFi" class="form-check-input amenity-checkbox" @(selectedAmenities.Contains("WiFi") ? "checked" : "")> WiFi
                        </label>
                        <label class="form-check-label me-2">
                            <input type="checkbox" name="amenities" value="AirCond" class="form-check-input amenity-checkbox" @(selectedAmenities.Contains("AirCond") ? "checked" : "")> Air-Cond
                        </label>
                        <label class="form-check-label me-2">
                            <input type="checkbox" name="amenities" value="Pool" class="form-check-input amenity-checkbox" @(selectedAmenities.Contains("Pool") ? "checked" : "")> Pool
                        </label>
                        <label class="form-check-label me-2">
                            <input type="checkbox" name="amenities" value="Kitchen" class="form-check-input amenity-checkbox" @(selectedAmenities.Contains("Kitchen") ? "checked" : "")> Kitchen
                        </label>
                        <label class="form-check-label me-2">
                            <input type="checkbox" name="amenities" value="FreeParking" class="form-check-input amenity-checkbox" @(selectedAmenities.Contains("FreeParking") ? "checked" : "")> Free Parking
                        </label>
                        <label class="form-check-label">
                            <input type="checkbox" name="amenities" value="SelfCheckIn" class="form-check-input amenity-checkbox" @(selectedAmenities.Contains("SelfCheckIn") ? "checked" : "")> Self Check-In
                        </label>
                    </div>
                </div>

                <div class="col-md-2 text-md-end">
                    <span class="search-label mb-1"><i class="bi bi-arrow-down-up"></i> Sort</span>
                    <select name="sort" id="selectSort" class="form-select form-select-sm" style="border-radius:10px;">
                        <option value="featured" selected="@(ViewBag.Sort == "featured")">Featured</option>
                        <option value="price_asc" selected="@(ViewBag.Sort == "price_asc")">Price: Low to High</option>
                        <option value="price_desc" selected="@(ViewBag.Sort == "price_desc")">Price: High to Low</option>
                        <option value="rating" selected="@(ViewBag.Sort == "rating")">Top Rated</option>
                        <option value="newest" selected="@(ViewBag.Sort == "newest")">Newest</option>
                    </select>
                </div>
            </div>
        </form>

        <!-- Quick Fly-to Area Chips -->
        <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-2">
            <span class="text-white-50" style="font-size:0.82rem;"><i class="bi bi-lightning-charge"></i> Quick Fly To:</span>
            <span class="area-chip" data-lat="3.1579" data-lng="101.7116" data-zoom="13">📍 Kuala Lumpur (KLCC)</span>
            <span class="area-chip" data-lat="5.4150" data-lng="100.3364" data-zoom="13">📍 Penang (George Town)</span>
            <span class="area-chip" data-lat="4.4721" data-lng="101.3756" data-zoom="12">📍 Cameron Highlands</span>
            <span class="area-chip" data-lat="3.0673" data-lng="101.6038" data-zoom="14">📍 Sunway Lagoon</span>
            <span class="area-chip" data-lat="6.2929" data-lng="99.7289" data-zoom="12">📍 Langkawi</span>
            <span class="area-chip" data-lat="2.1950" data-lng="102.2486" data-zoom="14">📍 Melaka Jonker</span>
        </div>
    </div>

    <!-- LEAFLET INTERACTIVE MAP WITH PRICE MARKERS -->
    <div id="mapContainer"></div>

    <!-- CATALOG GRID HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">
            Available Properties (<span id="countDisplay">@ViewBag.MatchingCount</span>)
        </h4>
        <div id="loadingSpinner" class="spinner-border spinner-border-sm text-danger d-none" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <!-- DYNAMIC AJAX RESULTS CONTAINER -->
    <div class="row g-4" id="catalogGrid">
        @await Html.PartialAsync("_PropertyCatalogGrid", Model)
    </div>
</div>

@section Scripts {
    <script>
        // Data for Interactive Map Price Pins
        const mapProperties = [
            @foreach (var p in Model)
            {
                var cover = p.Photos.FirstOrDefault(ph => ph.IsCover)?.FileName ?? p.Photos.FirstOrDefault()?.FileName ?? "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80";
                <text>
                {
                    id: @p.Id,
                    title: "@Html.Raw(p.Title.Replace("\"", "\\\""))",
                    price: @p.BaseNightlyRate,
                    lat: @p.Latitude,
                    lng: @p.Longitude,
                    city: "@p.City",
                    cover: "@cover",
                    type: "@p.PropertyType"
                },
                </text>
            }
        ];

        // 1. Initialize Leaflet Map
        const map = L.map('mapContainer').setView([3.8, 101.7], 7);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        // Add custom price markers to map
        mapProperties.forEach(p => {
            const priceHtml = `<div class="custom-price-pin" data-base-price="${p.price}">RM ${Math.round(p.price)}</div>`;
            const customIcon = L.divIcon({
                html: priceHtml,
                className: 'custom-leaflet-pin',
                iconSize: [70, 30],
                iconAnchor: [35, 15]
            });

            const popupContent = `
                <div style="width:200px; font-family:'Plus Jakarta Sans',sans-serif;">
                    <img src="${p.cover}" style="width:100%; height:110px; object-fit:cover; border-radius:10px; margin-bottom:8px;" />
                    <span class="badge bg-secondary mb-1" style="font-size:0.7rem;">${p.type}</span>
                    <h6 class="fw-bold mb-1 text-truncate" title="${p.title}" style="font-size:0.85rem;">${p.title}</h6>
                    <p class="text-muted mb-2" style="font-size:0.75rem;">${p.city}</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <strong class="text-danger" style="font-size:0.9rem;">RM ${p.price}/night</strong>
                        <a href="/Property/Details/${p.id}" class="btn btn-sm btn-dark px-2 py-1" style="font-size:0.72rem; border-radius:12px;">View</a>
                    </div>
                </div>
            `;

            L.marker([p.lat, p.lng], { icon: customIcon })
                .bindPopup(popupContent)
                .addTo(map);
        });

        // Toggle Map Button
        document.getElementById('btnToggleMap').addEventListener('click', function() {
            const container = document.getElementById('mapContainer');
            const txt = document.getElementById('mapToggleText');
            if (container.style.display === 'none') {
                container.style.display = 'block';
                txt.textContent = 'Hide Map';
                map.invalidateSize();
            } else {
                container.style.display = 'none';
                txt.textContent = 'Show Map';
            }
        });

        // Quick Fly-To Area Chips
        document.querySelectorAll('.area-chip').forEach(chip => {
            chip.addEventListener('click', function() {
                const lat = parseFloat(this.getAttribute('data-lat'));
                const lng = parseFloat(this.getAttribute('data-lng'));
                const zoom = parseInt(this.getAttribute('data-zoom'));
                map.flyTo([lat, lng], zoom, { duration: 1.5 });
            });
        });

        // 2. Interactive Price Range Slider
        const slider = document.getElementById('priceRange');
        const priceDisplay = document.getElementById('priceDisplay');
        const inputMaxPrice = document.getElementById('inputMaxPrice');

        slider.addEventListener('input', function() {
            priceDisplay.textContent = `Up to RM ${this.value}`;
            inputMaxPrice.value = this.value;
            triggerAjaxSearch();
        });

        // 3. AJAX Dynamic Filtering without Page Reload
        let debounceTimer;
        function triggerAjaxSearch(page = 1) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                executeAjaxSearch(page);
            }, 300);
        }

        function executeAjaxSearch(page = 1) {
            $('#loadingSpinner').removeClass('d-none');
            const formData = $('#searchForm').serialize() + '&page=' + page;

            $.ajax({
                url: '/Property/Catalog',
                type: 'GET',
                data: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(html) {
                    $('#catalogGrid').html(html);
                    $('#loadingSpinner').addClass('d-none');
                    bindWishlistEvents();
                    bindPaginationEvents();

                    // Re-apply currency conversion if active
                    const rate = parseFloat(localStorage.getItem('homenest_rate')) || 1.0;
                    const sym = localStorage.getItem('homenest_symbol') || 'RM';
                    if (rate !== 1.0) {
                        document.querySelectorAll('[data-base-price]').forEach(el => {
                            const base = parseFloat(el.getAttribute('data-base-price'));
                            if (!isNaN(base)) {
                                el.textContent = `${sym} ${(base * rate).toFixed(0)}`;
                            }
                        });
                    }
                },
                error: function() {
                    $('#loadingSpinner').addClass('d-none');
                }
            });
        }

        // Live inputs triggers
        $('#inputKeyword').on('input', () => triggerAjaxSearch(1));
        $('#inputCheckIn, #inputCheckOut, #selectGuests, #selectType, #selectSort, .amenity-checkbox').on('change', () => triggerAjaxSearch(1));
        $('#btnLiveSearch').on('click', () => triggerAjaxSearch(1));

        // 4. AJAX Wishlist Toggle
        function bindWishlistEvents() {
            $('.btn-wishlist').off('click').on('click', function(e) {
                e.preventDefault();
                const btn = $(this);
                const propId = btn.data('property-id');
                const icon = btn.find('i');

                $.ajax({
                    url: '/Property/ToggleWishlist',
                    type: 'POST',
                    data: { propertyId: propId },
                    success: function(res) {
                        if (res.success) {
                            if (res.isSaved) {
                                icon.removeClass('bi-heart text-dark').addClass('bi-heart-fill text-danger');
                            } else {
                                icon.removeClass('bi-heart-fill text-danger').addClass('bi-heart text-dark');
                            }
                        }
                    },
                    error: function(xhr) {
                        if (xhr.status === 401) {
                            window.location.href = '/Account/Login?returnUrl=/Property/Catalog';
                        }
                    }
                });
            });
        }

        // 5. AJAX Pagination Events
        function bindPaginationEvents() {
            $('.ajax-page-link').off('click').on('click', function(e) {
                e.preventDefault();
                const page = $(this).data('page');
                if (page > 0) {
                    executeAjaxSearch(page);
                    $('html, body').animate({ scrollTop: $('#catalogGrid').offset().top - 100 }, 400);
                }
            });
        }

        $(document).ready(function() {
            bindWishlistEvents();
            bindPaginationEvents();
        });
    </script>
}
