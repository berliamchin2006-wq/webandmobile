@model List<HomeNest.Models.Property>

@{
    ViewData["Title"] = "Browse Rentals";
    decimal maxRent = ViewBag.MaxRent != null ? (decimal)ViewBag.MaxRent : 2500m;
    string[] selectedAmenities = ViewBag.SelectedAmenities as string[] ?? Array.Empty<string>();
    int totalCount = ViewBag.TotalProperties ?? Model.Count;
    int matchCount = ViewBag.MatchingCount ?? Model.Count;

    // Serialize model for Leaflet map markers
    var mapData = Model.Select(p => new
    {
        id = p.Id,
        title = p.Title,
        propertyType = p.PropertyType,
        address = p.Address,
        city = p.City,
        lat = p.Latitude,
        lng = p.Longitude,
        cover = p.Photos.FirstOrDefault(x => x.IsCover)?.FileName ?? p.Photos.FirstOrDefault()?.FileName ?? "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800",
        minRent = p.RoomUnits.Any() ? p.RoomUnits.Min(r => r.MonthlyRent) : 0m,
        available = p.RoomUnits.Count(r => r.IsAvailable)
    }).ToList();
}

<div class="mb-5">
    <!-- Hero Section Banner -->
    <div class="hero-banner p-4 p-md-5 mb-4 position-relative">
        <div class="col-xl-9 col-lg-10 px-0 mb-4">
            <div class="mb-3">
                <span class="hero-verified-badge">
                    <i class="bi bi-shield-check text-success"></i> Verified Landlords & Instant Room Booking
                </span>
            </div>
            <h1 class="display-6 fw-bold mb-2 text-white" style="letter-spacing: -0.02em;">
                Find Your Ideal Student Room or Whole House in Malaysia
            </h1>
            <p class="mb-0 text-white-50" style="font-size: 1.05rem;">
                Interactive floor-plan room selection, QR viewing passes, transparent deposit calculation, and instant e-receipts.
            </p>
        </div>

        <!-- Floating White Search Card -->
        <div class="search-card-floating">
            <form method="get" asp-action="Catalog" id="searchFilterForm">
                <div class="row g-3 align-items-center mb-3">
                    <!-- Location / Keyword -->
                    <div class="col-lg-4 col-md-6">
                        <label class="search-label-micro">Search Location / Condo / University</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="keyword" class="form-control bg-light border-start-0" 
                                   placeholder="e.g. Setapak, TAR UMT, Semenyih, Sunway..." 
                                   value="@ViewBag.Keyword" />
                        </div>
                    </div>

                    <!-- Property Type -->
                    <div class="col-lg-3 col-md-6">
                        <label class="search-label-micro">Property Type</label>
                        <select name="propertyType" class="form-select bg-light">
                            <option value="">All Property Types</option>
                            <option value="Condominium" selected="@(ViewBag.PropertyType == "Condominium")">Condominium</option>
                            <option value="Apartment" selected="@(ViewBag.PropertyType == "Apartment")">Apartment</option>
                            <option value="Landed House" selected="@(ViewBag.PropertyType == "Landed House")">Landed House</option>
                            <option value="Service Residence" selected="@(ViewBag.PropertyType == "Service Residence")">Service Residence</option>
                        </select>
                    </div>

                    <!-- Max Room Rent Slider -->
                    <div class="col-lg-3 col-md-6">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="search-label-micro mb-1">Max Room Rent</label>
                            <span class="fw-bold" style="color: #0d9488; font-size: 0.85rem;" id="rentDisplay">
                                RM @maxRent.ToString("N0")
                            </span>
                        </div>
                        <input type="range" class="form-range custom-teal-range" 
                               name="maxRent" id="maxRentSlider" 
                               min="300" max="3000" step="50" 
                               value="@maxRent" />
                    </div>

                    <!-- Sort By -->
                    <div class="col-lg-2 col-md-6">
                        <label class="search-label-micro">Sort By</label>
                        <select name="sort" class="form-select bg-light">
                            <option value="featured" selected="@(ViewBag.Sort == "featured")">Featured & Verified First</option>
                            <option value="price_asc" selected="@(ViewBag.Sort == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(ViewBag.Sort == "price_desc")">Price: High to Low</option>
                            <option value="newest" selected="@(ViewBag.Sort == "newest")">Newest</option>
                        </select>
                    </div>
                </div>

                <!-- Bottom Amenities & Action Row -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pt-2 border-top gap-3">
                    <div class="d-flex flex-wrap align-items-center">
                        <span class="search-label-micro me-2 mb-0 d-inline-block">≈ Amenities:</span>
                        <label class="amenity-chip-check">
                            <input type="checkbox" name="amenities" value="WiFi" @(selectedAmenities.Contains("WiFi") ? "checked" : "") />
                            <span>📶 High-Speed WiFi</span>
                        </label>
                        <label class="amenity-chip-check">
                            <input type="checkbox" name="amenities" value="AirCond" @(selectedAmenities.Contains("AirCond") ? "checked" : "") />
                            <span>❄️ Air-Cond</span>
                        </label>
                        <label class="amenity-chip-check">
                            <input type="checkbox" name="amenities" value="NearLRT" @(selectedAmenities.Contains("NearLRT") ? "checked" : "") />
                            <span>🚇 Near LRT/MRT</span>
                        </label>
                        <label class="amenity-chip-check">
                            <input type="checkbox" name="amenities" value="CookingAllowed" @(selectedAmenities.Contains("CookingAllowed") ? "checked" : "") />
                            <span>🍳 Cooking Allowed</span>
                        </label>
                    </div>

                    <div class="d-flex align-items-center gap-3 ms-md-auto">
                        <span class="text-muted small fw-semibold" id="showingCountText">
                            Showing @matchCount of @totalCount properties
                        </span>
                        <button type="button" class="btn-toggle-map" id="toggleMapBtn">
                            <i class="bi bi-map-fill me-1"></i> Toggle Interactive Map
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm px-3 fw-bold text-white" style="background-color: #0d9488; border-color: #0d9488; border-radius: 50rem;">
                            Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Interactive Leaflet Map Section -->
    <div class="card border-0 shadow-sm p-4 mb-4 rounded-4" id="mapSection">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
            <div>
                <h5 class="fw-bold mb-1" style="color: #0f172a;">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> Interactive Property Location Map (Leaflet.js Integration)
                </h5>
                <p class="text-muted small mb-0">
                    Click any marker on the map to inspect room availability and open the interactive floor plan.
                </p>
            </div>
            <!-- Quick Filter Chips -->
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="quick-filter-chip active" data-filter="all">All Areas</button>
                <button type="button" class="quick-filter-chip" data-filter="setapak" data-lat="3.2015" data-lng="101.7168">Setapak / KL</button>
                <button type="button" class="quick-filter-chip" data-filter="semenyih" data-lat="2.9450" data-lng="101.8732">Semenyih</button>
                <button type="button" class="quick-filter-chip" data-filter="sunway" data-lat="3.0645" data-lng="101.6035">Subang / Sunway</button>
            </div>
        </div>

        <div id="propertyMap" style="height: 380px; width: 100%; border-radius: 14px; border: 1px solid #e2e8f0; z-index: 1;"></div>
    </div>

    <!-- Properties Grid Section -->
    <div id="propertyGridSection">
        @await Html.PartialAsync("_PropertyCatalogGrid", Model)
    </div>
</div>

@section Scripts {
    <script>
        // 1. Max rent slider display listener
        const slider = document.getElementById("maxRentSlider");
        const display = document.getElementById("rentDisplay");
        if (slider && display) {
            slider.addEventListener("input", function () {
                display.textContent = "RM " + Number(this.value).toLocaleString('en-US');
            });
        }

        // 2. Map Toggle
        const toggleBtn = document.getElementById("toggleMapBtn");
        const mapSection = document.getElementById("mapSection");
        if (toggleBtn && mapSection) {
            toggleBtn.addEventListener("click", function () {
                if (mapSection.style.display === "none") {
                    mapSection.style.display = "block";
                    setTimeout(() => { map.invalidateSize(); }, 200);
                } else {
                    mapSection.style.display = "none";
                }
            });
        }

        // 3. Leaflet.js Initialization
        const propertiesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mapData));
        
        // Center on Klang Valley / Greater KL
        const map = L.map('propertyMap', { scrollWheelZoom: false }).setView([3.1390, 101.6869], 11);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        const markers = [];

        // Custom green pinpoint icon
        const greenIcon = L.divIcon({
            className: 'custom-map-pin',
            html: `<div style="background:#0d9488;color:#fff;width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 8px rgba(0,0,0,0.3);border:2px solid #fff;"><i class="bi bi-house-door-fill" style="font-size:14px;"></i></div>`,
            iconSize: [34, 34],
            iconAnchor: [17, 34],
            popupAnchor: [0, -32]
        });

        if (propertiesData && propertiesData.length > 0) {
            const group = [];
            propertiesData.forEach(p => {
                let img = p.cover;
                if (!img.startsWith("http") && !img.startsWith("/")) {
                    img = "/uploads/properties/" + img;
                }

                const popupContent = `
                    <div style="width: 220px; font-family: 'Plus Jakarta Sans', sans-serif;">
                        <img src="${img}" style="width:100%; height:110px; object-fit:cover; border-radius:8px; margin-bottom:8px;" onerror="this.src='https://placehold.co/400x250/e2e8f0/334155?text=HomeNest';" />
                        <div style="font-weight:700; font-size:13px; margin-bottom:2px; line-height:1.2;">${p.title}</div>
                        <div style="color:#64748b; font-size:11px; margin-bottom:6px;"><i class="bi bi-geo-alt-fill text-danger"></i> ${p.city}</div>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:6px; border-top:1px solid #f1f5f9; pt-1;">
                            <div style="color:#0d9488; font-weight:700; font-size:13px;">RM ${Number(p.minRent).toLocaleString()}<span style="font-size:10px; color:#64748b;">/mo</span></div>
                            <a href="/Property/Details/${p.id}" class="btn btn-sm text-white" style="background:#0d9488; font-size:11px; padding:2px 8px; border-radius:4px; text-decoration:none;">View</a>
                        </div>
                    </div>
                `;

                const marker = L.marker([p.lat, p.lng], { icon: greenIcon })
                    .bindPopup(popupContent)
                    .addTo(map);

                marker.propertyCity = (p.city || "").toLowerCase();
                markers.push(marker);
                group.push([p.lat, p.lng]);
            });

            if (group.length > 0) {
                map.fitBounds(group, { padding: [40, 40] });
            }
        }

        // 4. Quick filter chips click handler
        document.querySelectorAll(".quick-filter-chip").forEach(btn => {
            btn.addEventListener("click", function () {
                document.querySelectorAll(".quick-filter-chip").forEach(b => b.classList.remove("active"));
                this.classList.add("active");

                const filter = this.getAttribute("data-filter");
                const lat = parseFloat(this.getAttribute("data-lat"));
                const lng = parseFloat(this.getAttribute("data-lng"));

                if (lat && lng) {
                    map.flyTo([lat, lng], 14, { animate: true, duration: 1.2 });
                } else {
                    if (markers.length > 0) {
                        const bounds = L.latLngBounds(markers.map(m => m.getLatLng()));
                        map.flyToBounds(bounds, { padding: [40, 40], duration: 1 });
                    }
                }
            });
        });
    </script>
}
