@model List<HomeNest.Models.Property>
@{
    ViewData["Title"] = "Find Holiday Homes & Vacation Rentals";
    string[] selectedAmenities = ViewBag.SelectedAmenities as string[] ?? Array.Empty<string>();
}

@section Styles {
    <style>
        /* Catalog Page Specific Polishes */
        .catalog-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .amenity-toggle {
            cursor: pointer;
            user-select: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: var(--r-full);
            border: 1px solid var(--p-line);
            background: var(--p-surface);
            font-size: 0.82rem;
            font-weight: 500;
            color: var(--p-ink-secondary);
            transition: all var(--dur-quick) var(--ease-standard);
        }
        .amenity-toggle:hover {
            border-color: var(--p-muted-light);
            background: var(--p-surface-card);
        }
        .amenity-toggle input:checked + span {
            color: var(--p-accent);
            font-weight: 700;
        }
        .amenity-toggle:has(input:checked) {
            border-color: var(--p-accent);
            background: var(--p-accent-subtle);
        }

        .catalog-sort-select {
            background: var(--p-surface);
            border: 1px solid var(--p-line);
            color: var(--p-ink);
            border-radius: var(--r-md);
            padding: 6px 12px;
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            outline: none;
            transition: border-color var(--dur-quick) var(--ease-standard);
        }
        .catalog-sort-select:focus {
            border-color: var(--p-accent);
        }
    </style>
}

<div class="taste-wrap pt-3">
    
    <!-- EDITORIAL WELCOME HEADER (Airbnb Style) -->
    <div class="taste-catalog-header mb-4">
        <span class="taste-hero-badge mb-2">
            <i class="bi bi-houses-fill"></i> Handpicked Malaysia Stays
        </span>
        <h1 class="taste-hero-title">Find places to stay in Malaysia</h1>
        <p class="taste-hero-subtitle mb-0">
            Discover handpicked villas, city lofts, and scenic retreats across Malaysia with verified superhosts and digital QR passes.
        </p>
    </div>

    <!-- MAIN SEARCH BAR (Capsule Pill) -->
    <form id="searchForm">
        <div class="airbnb-search-bar">
            
            <!-- Destination / Where -->
            <div class="airbnb-search-segment">
                <label class="taste-search-label" for="inputKeyword">
                    <i class="bi bi-geo-alt-fill text-danger"></i> Where
                </label>
                <input type="text" name="keyword" id="inputKeyword" class="taste-search-input" 
                       placeholder="KLCC, Penang, Cameron, Langkawi..." value="@ViewBag.Keyword" autocomplete="off" />
            </div>

            <!-- Check In -->
            <div class="airbnb-search-segment">
                <label class="taste-search-label" for="inputCheckIn">
                    <i class="bi bi-calendar-check text-primary"></i> Check In
                </label>
                <input type="date" name="checkIn" id="inputCheckIn" class="taste-search-input" value="@ViewBag.CheckIn" />
            </div>

            <!-- Check Out -->
            <div class="airbnb-search-segment">
                <label class="taste-search-label" for="inputCheckOut">
                    <i class="bi bi-calendar-x text-primary"></i> Check Out
                </label>
                <input type="date" name="checkOut" id="inputCheckOut" class="taste-search-input" value="@ViewBag.CheckOut" />
            </div>

            <!-- Guests -->
            <div class="airbnb-search-segment">
                <label class="taste-search-label" for="selectGuests">
                    <i class="bi bi-people-fill text-warning"></i> Who
                </label>
                <select name="guests" id="selectGuests" class="taste-search-input">
                    <option value="1" selected="@(ViewBag.Guests == 1)">1 Guest</option>
                    <option value="2" selected="@(ViewBag.Guests == 2)">2 Guests</option>
                    <option value="4" selected="@(ViewBag.Guests == 4)">4+ Guests</option>
                    <option value="6" selected="@(ViewBag.Guests == 6)">6+ Guests</option>
                    <option value="8" selected="@(ViewBag.Guests == 8)">8+ Group</option>
                </select>
            </div>

            <!-- Property Type -->
            <div class="airbnb-search-segment">
                <label class="taste-search-label" for="selectType">
                    <i class="bi bi-building text-info"></i> Type
                </label>
                <select name="propertyType" id="selectType" class="taste-search-input">
                    <option value="All">All Types</option>
                    <option value="Condominium" selected="@(ViewBag.PropertyType == "Condominium")">Condo</option>
                    <option value="Villa" selected="@(ViewBag.PropertyType == "Villa")">Villa</option>
                    <option value="Townhouse" selected="@(ViewBag.PropertyType == "Townhouse")">Townhouse</option>
                    <option value="Chalet" selected="@(ViewBag.PropertyType == "Chalet")">Chalet</option>
                    <option value="Studio" selected="@(ViewBag.PropertyType == "Studio")">Studio</option>
                </select>
            </div>

            <!-- Search Button -->
            <div class="p-1">
                <button type="button" id="btnLiveSearch" class="btn btn-airbnb rounded-circle p-0 d-flex align-items-center justify-content-center shadow" style="width:48px; height:48px;" title="Search Stays">
                    <i class="bi bi-search fs-5"></i>
                </button>
            </div>
        </div>

        <!-- EXPANDABLE FILTERS DRAWER -->
        <div id="filterDrawer" class="taste-filter-drawer d-none">
            <div class="row g-3 align-items-center">
                <div class="col-lg-4 col-md-5">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="taste-search-label mb-0"><i class="bi bi-sliders"></i> Nightly Rate Range</span>
                        <span class="fw-bold text-dark-emphasis" style="font-size:0.85rem;" id="priceDisplay">Up to RM @ViewBag.MaxPrice</span>
                    </div>
                    <input type="range" class="form-range" id="priceRange" min="50" max="1500" step="25" value="@ViewBag.MaxPrice" />
                    <input type="hidden" name="maxPrice" id="inputMaxPrice" value="@ViewBag.MaxPrice" />
                </div>

                <div class="col-lg-6 col-md-7">
                    <span class="taste-search-label mb-1"><i class="bi bi-check2-circle"></i> Popular Amenities</span>
                    <div class="d-flex flex-wrap gap-2">
                        <label class="amenity-toggle">
                            <input type="checkbox" name="amenities" value="WiFi" class="d-none amenity-checkbox" @(selectedAmenities.Contains("WiFi") ? "checked" : "")>
                            <span><i class="bi bi-wifi"></i> WiFi</span>
                        </label>
                        <label class="amenity-toggle">
                            <input type="checkbox" name="amenities" value="AirCond" class="d-none amenity-checkbox" @(selectedAmenities.Contains("AirCond") ? "checked" : "")>
                            <span><i class="bi bi-wind"></i> Air-Cond</span>
                        </label>
                        <label class="amenity-toggle">
                            <input type="checkbox" name="amenities" value="Pool" class="d-none amenity-checkbox" @(selectedAmenities.Contains("Pool") ? "checked" : "")>
                            <span><i class="bi bi-water"></i> Pool</span>
                        </label>
                        <label class="amenity-toggle">
                            <input type="checkbox" name="amenities" value="Kitchen" class="d-none amenity-checkbox" @(selectedAmenities.Contains("Kitchen") ? "checked" : "")>
                            <span><i class="bi bi-egg-fried"></i> Kitchen</span>
                        </label>
                        <label class="amenity-toggle">
                            <input type="checkbox" name="amenities" value="FreeParking" class="d-none amenity-checkbox" @(selectedAmenities.Contains("FreeParking") ? "checked" : "")>
                            <span><i class="bi bi-p-square"></i> Free Parking</span>
                        </label>
                        <label class="amenity-toggle">
                            <input type="checkbox" name="amenities" value="SelfCheckIn" class="d-none amenity-checkbox" @(selectedAmenities.Contains("SelfCheckIn") ? "checked" : "")>
                            <span><i class="bi bi-key"></i> Self Check-In</span>
                        </label>
                    </div>
                </div>

                <div class="col-lg-2 col-12 text-lg-end">
                    <span class="taste-search-label mb-1 d-none d-lg-block"><i class="bi bi-arrow-down-up"></i> Sort</span>
                    <select name="sort" id="selectSort" class="catalog-sort-select w-100">
                        <option value="featured" selected="@(ViewBag.Sort == "featured")">Featured</option>
                        <option value="price_asc" selected="@(ViewBag.Sort == "price_asc")">Price: Low to High</option>
                        <option value="price_desc" selected="@(ViewBag.Sort == "price_desc")">Price: High to Low</option>
                        <option value="rating" selected="@(ViewBag.Sort == "rating")">Top Rated</option>
                        <option value="newest" selected="@(ViewBag.Sort == "newest")">Newest</option>
                    </select>
                </div>
            </div>

            <!-- Quick Fly-to Destination Chips -->
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top" style="border-color: var(--p-line) !important;">
                <span class="taste-search-label mb-0"><i class="bi bi-compass"></i> Popular Destinations:</span>
                <span class="taste-area-chip" data-keyword="Kuala Lumpur" data-lat="3.1579" data-lng="101.7116" data-zoom="13">📍 Kuala Lumpur (KLCC)</span>
                <span class="taste-area-chip" data-keyword="Penang" data-lat="5.4150" data-lng="100.3364" data-zoom="13">📍 Penang (George Town)</span>
                <span class="taste-area-chip" data-keyword="Cameron Highlands" data-lat="4.4721" data-lng="101.3756" data-zoom="12">📍 Cameron Highlands</span>
                <span class="taste-area-chip" data-keyword="Sunway" data-lat="3.0673" data-lng="101.6038" data-zoom="14">📍 Sunway Lagoon</span>
                <span class="taste-area-chip" data-keyword="Langkawi" data-lat="6.2929" data-lng="99.7289" data-zoom="12">📍 Langkawi</span>
                <span class="taste-area-chip" data-keyword="Melaka" data-lat="2.1950" data-lng="102.2486" data-zoom="14">📍 Melaka Jonker</span>
            </div>
        </div>
    </form>

    <!-- CATEGORY LIFESTYLE BAR & TOOLBAR -->
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
        <div class="taste-category-bar flex-grow-1 mb-0 border-0 pb-0">
            <a href="javascript:void(0)" class="taste-category-item active" data-type="All">
                <i class="bi bi-house-heart"></i>
                <span>All Stays</span>
            </a>
            <a href="javascript:void(0)" class="taste-category-item" data-type="Villa">
                <i class="bi bi-water"></i>
                <span>Beach & Villas</span>
            </a>
            <a href="javascript:void(0)" class="taste-category-item" data-type="Condominium">
                <i class="bi bi-buildings"></i>
                <span>City Lofts</span>
            </a>
            <a href="javascript:void(0)" class="taste-category-item" data-type="Chalet">
                <i class="bi bi-tree"></i>
                <span>Highlands</span>
            </a>
            <a href="javascript:void(0)" class="taste-category-item" data-type="Townhouse">
                <i class="bi bi-bank"></i>
                <span>Heritage</span>
            </a>
            <a href="javascript:void(0)" class="taste-category-item" data-type="Studio">
                <i class="bi bi-cup-hot"></i>
                <span>Cozy Studios</span>
            </a>
        </div>
        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <button type="button" id="btnToggleFilters" class="btn btn-outline-taste rounded-pill px-3 py-2" style="font-size:0.85rem;">
                <i class="bi bi-sliders me-1"></i> <span class="d-none d-sm-inline">Filters</span>
            </button>
            <button type="button" id="btnToggleMap" class="btn btn-outline-taste rounded-pill px-3 py-2" style="font-size:0.85rem;">
                <i class="bi bi-map me-1"></i> <span id="mapToggleText">Show Map</span>
            </button>
        </div>
    </div>

    <!-- LEAFLET INTERACTIVE MAP (Collapsible) -->
    <div id="mapContainer" class="mb-4" style="height: 400px; border-radius: var(--r-xl); overflow: hidden; display: none; border: 1px solid var(--p-line);"></div>

    <!-- CATALOG GRID HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0 text-dark-emphasis">
                Available Stays (<span id="countDisplay">@ViewBag.MatchingCount</span>)
            </h4>
            <p class="text-muted small mb-0">Book directly with instant confirmation and protected host payouts</p>
        </div>
        <div id="loadingSpinner" class="spinner-border spinner-border-sm text-danger d-none" role="status">
            <span class="visually-hidden">Loading stays...</span>
        </div>
    </div>

    <!-- DYNAMIC AJAX RESULTS CONTAINER -->
    <div class="row g-4" id="catalogGrid">
        @await Html.PartialAsync("_PropertyCatalogGrid", Model)
    </div>

    <!-- FLOATING MAP BUTTON (Signature Airbnb Feature) -->
    <button type="button" id="floatingMapBtn" class="taste-floating-map-btn" title="Toggle Interactive Map">
        <i class="bi bi-map-fill"></i>
        <span id="floatingMapText">Show map</span>
    </button>
</div>

@section Scripts {
    <script>
        // Data for Interactive Map Price Pins
        const mapProperties = [
            @foreach (var p in Model)
            {
                var cover = p.Photos.FirstOrDefault(ph => ph.IsCover)?.FileName ?? p.Photos.FirstOrDefault()?.FileName ?? "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80";
                <text>
                {
                    id: @p.Id,
                    title: "@Html.Raw(p.Title.Replace("\"", "\\\""))",
                    price: @p.BaseNightlyRate,
                    lat: @p.Latitude,
                    lng: @p.Longitude,
                    city: "@p.City",
                    cover: "@cover",
                    type: "@p.PropertyType"
                },
                </text>
            }
        ];

        // 1. Initialize Leaflet Map
        const map = L.map('mapContainer').setView([3.8, 101.7], 7);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        // Add custom price markers to map
        mapProperties.forEach(p => {
            const priceHtml = `<div class="custom-price-pin" data-base-price="${p.price}">RM ${Math.round(p.price)}</div>`;
            const customIcon = L.divIcon({
                html: priceHtml,
                className: 'custom-leaflet-pin',
                iconSize: [74, 32],
                iconAnchor: [37, 16]
            });

            const popupContent = `
                <div style="width:210px; font-family:'Plus Jakarta Sans',sans-serif; padding:4px;">
                    <img src="${p.cover}" style="width:100%; height:115px; object-fit:cover; border-radius:10px; margin-bottom:8px;" />
                    <span class="badge bg-secondary mb-1" style="font-size:0.68rem;">${p.type}</span>
                    <h6 class="fw-bold mb-1 text-truncate" title="${p.title}" style="font-size:0.86rem;">${p.title}</h6>
                    <p class="text-muted mb-2" style="font-size:0.75rem;"><i class="bi bi-geo-alt"></i> ${p.city}</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <strong class="text-danger" style="font-size:0.92rem;">RM ${p.price}/night</strong>
                        <a href="/Property/Details/${p.id}" class="btn btn-sm btn-airbnb px-2 py-1" style="font-size:0.75rem; border-radius:8px;">View</a>
                    </div>
                </div>
            `;

            L.marker([p.lat, p.lng], { icon: customIcon })
                .bindPopup(popupContent)
                .addTo(map);
        });

        // Toggle Map Logic (Header button + Floating Airbnb Bottom Pill)
        function toggleMap(forceState) {
            const container = document.getElementById('mapContainer');
            const txt1 = document.getElementById('mapToggleText');
            const txt2 = document.getElementById('floatingMapText');
            const isHidden = container.style.display === 'none';
            const show = forceState !== undefined ? forceState : isHidden;

            if (show) {
                container.style.display = 'block';
                if (txt1) txt1.textContent = 'Hide Map';
                if (txt2) txt2.textContent = 'Show list';
                map.invalidateSize();
                container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                container.style.display = 'none';
                if (txt1) txt1.textContent = 'Show Map';
                if (txt2) txt2.textContent = 'Show map';
            }
        }

        document.getElementById('btnToggleMap').addEventListener('click', () => toggleMap());
        document.getElementById('floatingMapBtn').addEventListener('click', () => toggleMap());

        // Toggle Expandable Filter Drawer
        document.getElementById('btnToggleFilters').addEventListener('click', function() {
            const drawer = document.getElementById('filterDrawer');
            drawer.classList.toggle('d-none');
        });

        // Category Lifestyle Item Clicks
        document.querySelectorAll('.taste-category-item').forEach(item => {
            item.addEventListener('click', function() {
                document.querySelectorAll('.taste-category-item').forEach(i => i.classList.remove('active'));
                this.classList.add('active');
                const selectedType = this.getAttribute('data-type');
                const typeSelect = document.getElementById('selectType');
                if (typeSelect) {
                    typeSelect.value = selectedType;
                    triggerAjaxSearch();
                }
            });
        });

        // Quick Fly-To Area Chips
        document.querySelectorAll('.taste-area-chip').forEach(chip => {
            chip.addEventListener('click', function() {
                const keyword = this.getAttribute('data-keyword');
                if (keyword) {
                    document.getElementById('inputKeyword').value = keyword;
                }
                const lat = parseFloat(this.getAttribute('data-lat'));
                const lng = parseFloat(this.getAttribute('data-lng'));
                const zoom = parseInt(this.getAttribute('data-zoom'));
                if (lat && lng) {
                    toggleMap(true);
                    map.flyTo([lat, lng], zoom, { duration: 1.5 });
                }
                triggerAjaxSearch();
            });
        });

        // 2. Interactive Price Range Slider
        const slider = document.getElementById('priceRange');
        const priceDisplay = document.getElementById('priceDisplay');
        const inputMaxPrice = document.getElementById('inputMaxPrice');

        slider.addEventListener('input', function() {
            priceDisplay.textContent = `Up to RM ${this.value}`;
            inputMaxPrice.value = this.value;
            triggerAjaxSearch();
        });

        // 3. AJAX Dynamic Filtering without Page Reload
        let debounceTimer;
        function triggerAjaxSearch(page = 1) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                executeAjaxSearch(page);
            }, 250);
        }

        function executeAjaxSearch(page = 1) {
            $('#loadingSpinner').removeClass('d-none');
            const formData = $('#searchForm').serialize() + '&page=' + page;

            $.ajax({
                url: '/Property/Catalog',
                type: 'GET',
                data: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(html) {
                    $('#catalogGrid').html(html);
                    $('#loadingSpinner').addClass('d-none');
                    bindWishlistEvents();
                    bindPaginationEvents();

                    // Re-apply currency conversion if active
                    const rate = parseFloat(localStorage.getItem('homenest_rate')) || 1.0;
                    const sym = localStorage.getItem('homenest_symbol') || 'RM';
                    if (rate !== 1.0) {
                        document.querySelectorAll('[data-base-price]').forEach(el => {
                            const base = parseFloat(el.getAttribute('data-base-price'));
                            if (!isNaN(base)) {
                                el.textContent = `${sym} ${(base * rate).toFixed(0)}`;
                            }
                        });
                    }
                },
                error: function() {
                    $('#loadingSpinner').addClass('d-none');
                }
            });
        }

        // Live inputs triggers
        $('#inputKeyword').on('input', () => triggerAjaxSearch(1));
        $('#inputCheckIn, #inputCheckOut, #selectGuests, #selectType, #selectSort, .amenity-checkbox').on('change', () => triggerAjaxSearch(1));
        $('#btnLiveSearch').on('click', () => triggerAjaxSearch(1));

        // 4. AJAX Wishlist Toggle
        function bindWishlistEvents() {
            $('.btn-wishlist').off('click').on('click', function(e) {
                e.preventDefault();
                const btn = $(this);
                const propId = btn.data('property-id');
                const icon = btn.find('i');

                $.ajax({
                    url: '/Property/ToggleWishlist',
                    type: 'POST',
                    data: { propertyId: propId },
                    success: function(res) {
                        if (res.success) {
                            if (res.isSaved) {
                                icon.removeClass('bi-heart text-dark').addClass('bi-heart-fill text-danger');
                            } else {
                                icon.removeClass('bi-heart-fill text-danger').addClass('bi-heart text-dark');
                            }
                        }
                    },
                    error: function(xhr) {
                        if (xhr.status === 401) {
                            window.location.href = '/Account/Login?returnUrl=/Property/Catalog';
                        }
                    }
                });
            });
        }

        // 5. AJAX Pagination Events
        function bindPaginationEvents() {
            $('.ajax-page-link').off('click').on('click', function(e) {
                e.preventDefault();
                const page = $(this).data('page');
                if (page > 0) {
                    executeAjaxSearch(page);
                    $('html, body').animate({ scrollTop: $('#catalogGrid').offset().top - 100 }, 300);
                }
            });
        }

        $(document).ready(function() {
            bindWishlistEvents();
            bindPaginationEvents();
        });
    </script>
}
