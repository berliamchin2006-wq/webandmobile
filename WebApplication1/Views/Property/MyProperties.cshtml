@model List<HomeNest.Models.Property>
@{
    ViewData["Title"] = "My Property Listings";
}

<div class="container py-4">
    
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-danger bg-opacity-75 rounded-pill px-3 py-1 mb-1">Module 2: Listing Management</span>
            <h2 class="fw-bold mb-0">My Hosted Properties (@Model.Count)</h2>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-action="BatchImport" class="btn btn-outline-dark rounded-pill px-3">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Batch CSV Import
            </a>
            <a asp-action="Create" class="btn btn-airbnb rounded-pill px-4">
                <i class="bi bi-plus-lg me-1"></i> Create Listing
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 border rounded-4 bg-light">
            <i class="bi bi-houses fs-1 text-muted"></i>
            <h4 class="mt-3 fw-bold">You don't have any listings yet</h4>
            <p class="text-muted">Start hosting your home, condo, or vacation villa on HomeNest today.</p>
            <a asp-action="Create" class="btn btn-airbnb rounded-pill px-4 mt-2">Publish First Listing</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in Model)
            {
                var cover = p.Photos.FirstOrDefault(ph => ph.IsCover)?.FileName 
                    ?? p.Photos.FirstOrDefault()?.FileName 
                    ?? "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80";

                double avgRating = p.Reviews.Any() ? Math.Round(p.Reviews.Average(r => r.OverallRating), 1) : 5.0;

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border rounded-4 shadow-sm overflow-hidden">
                        
                        <div style="height: 190px; overflow: hidden; position: relative;">
                            <img src="@cover" class="w-100 h-100 object-fit-cover" />
                            <span class="position-absolute top-0 end-0 m-2 badge @(p.IsActive ? "bg-success" : "bg-secondary") rounded-pill px-3 py-1">
                                @(p.IsActive ? "Active / Listed" : "Paused / Unlisted")
                            </span>
                            <span class="position-absolute bottom-0 start-0 m-2 badge bg-dark bg-opacity-75 rounded-pill">
                                @p.PropertyType
                            </span>
                        </div>

                        <div class="p-3 d-flex flex-column justify-content-between flex-grow-1">
                            <div>
                                <h6 class="fw-bold mb-1 text-truncate" title="@p.Title">@p.Title</h6>
                                <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> @p.City, @p.State</p>

                                <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded-3" style="font-size:0.82rem;">
                                    <div>
                                        <span class="text-muted d-block">Base Rate</span>
                                        <strong class="text-dark">RM @p.BaseNightlyRate.ToString("N0")/night</strong>
                                    </div>
                                    <div>
                                        <span class="text-muted d-block">Weekend</span>
                                        <strong class="text-dark">RM @p.CustomWeekendRate.ToString("N0")</strong>
                                    </div>
                                    <div>
                                        <span class="text-muted d-block">Bookings</span>
                                        <strong class="text-primary">@p.Bookings.Count</strong>
                                    </div>
                                    <div>
                                        <span class="text-muted d-block">Rating</span>
                                        <strong class="text-warning"><i class="bi bi-star-fill"></i> @avgRating</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 pt-2 border-top">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary flex-fill rounded-pill">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark flex-fill rounded-pill">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill" title="@(p.IsActive ? "Unlist Listing" : "Publish Listing")">
                                        <i class="bi @(p.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
