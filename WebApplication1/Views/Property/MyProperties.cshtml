@model List<HomeNest.Models.Property>

@{
    ViewData["Title"] = "My Properties";
}

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">My Properties</h2>
            <p class="text-muted">Manage your listed rental units and rooms</p>
        </div>
        @if (User.IsInRole("Owner"))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add New Property
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <i class="bi bi-houses display-3 text-muted mb-3"></i>
            <h4>No Properties Listed Yet</h4>
            <p class="text-muted">Start listing your properties and rooms to attract verified tenants.</p>
            @if (User.IsInRole("Owner"))
            {
                <div class="mt-2">
                    <a asp-action="Create" class="btn btn-primary">Create Your First Listing</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="table-responsive bg-white rounded shadow-sm p-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Property</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Rooms</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@item.Title</div>
                                <small class="text-muted">ID: #@item.Id</small>
                            </td>
                            <td><span class="badge bg-secondary-subtle text-secondary border">@item.PropertyType</span></td>
                            <td>@item.City, @item.State</td>
                            <td>
                                <span class="badge bg-info-subtle text-info border">@item.RoomUnits.Count Unit(s)</span>
                            </td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-1" title="View & Manage Rooms">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm me-1" title="Edit Property Details">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")" 
                                            onclick="return confirm('Toggle active status for this property?');">
                                        <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-check-circle")"></i>
                                        @(item.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

