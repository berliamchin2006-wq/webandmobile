@model HomeNest.Models.PropertyFormVM

@{
    ViewData["Title"] = "Create Property Listing";
    var amenitiesList = new[] { "WiFi", "AirCond", "WashingMachine", "WaterHeater", "Refrigerator", "Gym", "SwimmingPool", "Security24Hr", "Balcony", "Kitchen" };
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm p-4 p-md-5">
            <h2 class="fw-bold mb-1">List a New Property</h2>
            <p class="text-muted mb-4">Provide accurate details to help prospective tenants find your place.</p>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Listing Title *</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. PV15 Platinum Lake Condominium (Near TAR UMT)" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PropertyType" class="form-label fw-semibold">Property Type *</label>
                        <select asp-for="PropertyType" class="form-select">
                            <option value="Condominium">Condominium</option>
                            <option value="Apartment">Apartment</option>
                            <option value="Landed House">Landed House</option>
                            <option value="Service Residence">Service Residence</option>
                            <option value="Townhouse">Townhouse</option>
                        </select>
                        <span asp-validation-for="PropertyType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Postcode" class="form-label fw-semibold">Postcode *</label>
                        <input asp-for="Postcode" class="form-control" placeholder="53300" />
                        <span asp-validation-for="Postcode" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold">Street Address *</label>
                    <input asp-for="Address" class="form-control" placeholder="e.g. Jalan Danau Saujana, Taman Danau Kota" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-semibold">City *</label>
                        <input asp-for="City" class="form-control" placeholder="Setapak" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="State" class="form-label fw-semibold">State *</label>
                        <select asp-for="State" class="form-select">
                            <option value="Kuala Lumpur">Kuala Lumpur</option>
                            <option value="Selangor">Selangor</option>
                            <option value="Penang">Penang</option>
                            <option value="Johor">Johor</option>
                            <option value="Perak">Perak</option>
                            <option value="Melaka">Melaka</option>
                            <option value="Sabah">Sabah</option>
                            <option value="Sarawak">Sarawak</option>
                        </select>
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Description *</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detail the furnishings, nearby colleges, LRT/bus stations, and house rules..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold d-block">Amenities Available</label>
                    <div class="row row-cols-2 row-cols-md-3 g-2">
                        @foreach (var am in amenitiesList)
                        {
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedAmenities" value="@am" id="am_@am" />
                                    <label class="form-check-label" for="am_@am">@am</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Photos" class="form-label fw-semibold">Upload Photos</label>
                    <input asp-for="Photos" type="file" multiple class="form-control" accept="image/png, image/jpeg, image/webp" />
                    <span asp-validation-for="Photos" class="text-danger small"></span>
                    <small class="text-muted d-block mt-1">Accepted formats: JPG, PNG, WEBP. Max 5MB per file.</small>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="MyProperties" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Publish Listing</button>
                </div>
            </form>
        </div>
    </div>
</div>

