@model List<HomeNest.Models.Booking>
@{
    ViewData["Title"] = "My Trips & Reservations";
    string currentFilter = ViewBag.CurrentFilter as string ?? "all";
}

<div class="container py-4">
    
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-danger bg-opacity-75 rounded-pill px-3 py-1 mb-1">Module 3: Reservation Management</span>
            <h2 class="fw-bold mb-0">My Trips & Reservations</h2>
        </div>
        <a asp-controller="Property" asp-action="Catalog" class="btn btn-airbnb rounded-pill px-4">
            <i class="bi bi-search me-1"></i> Book Another Stay
        </a>
    </div>

    <!-- STATUS FILTER PILLS -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="MyBookings" asp-route-filter="all" class="btn btn-sm @(currentFilter == "all" ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3">
            All Reservations (@Model.Count)
        </a>
        <a asp-action="MyBookings" asp-route-filter="upcoming" class="btn btn-sm @(currentFilter == "upcoming" ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3">
            Upcoming & Active
        </a>
        <a asp-action="MyBookings" asp-route-filter="completed" class="btn btn-sm @(currentFilter == "completed" ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3">
            Past Stays
        </a>
        <a asp-action="MyBookings" asp-route-filter="cancelled" class="btn btn-sm @(currentFilter == "cancelled" ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3">
            Cancelled
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 border rounded-4 bg-light">
            <i class="bi bi-suitcase-lg fs-1 text-muted"></i>
            <h4 class="mt-3 fw-bold">No trips found</h4>
            <p class="text-muted">You haven't booked any vacation stays matching this filter yet.</p>
            <a asp-controller="Property" asp-action="Catalog" class="btn btn-airbnb rounded-pill px-4 mt-2">Explore Malaysia Stays</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var b in Model)
            {
                var p = b.Property;
                var cover = p.Photos.FirstOrDefault(ph => ph.IsCover)?.FileName 
                    ?? p.Photos.FirstOrDefault()?.FileName 
                    ?? "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80";

                string statusBadgeClass = b.Status switch
                {
                    "Confirmed" => "bg-primary text-white",
                    "CheckedIn" => "bg-success text-white",
                    "CheckedOut" => "bg-secondary text-white",
                    "Cancelled" => "bg-danger text-white",
                    _ => "bg-warning text-dark"
                };

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border rounded-4 shadow-sm overflow-hidden d-flex flex-column justify-content-between">
                        
                        <div>
                            <div style="height: 180px; overflow: hidden; position: relative;">
                                <img src="@cover" class="w-100 h-100 object-fit-cover" />
                                <span class="position-absolute top-0 end-0 m-2 badge @statusBadgeClass rounded-pill px-3 py-1">
                                    @b.Status
                                </span>
                                <span class="position-absolute bottom-0 start-0 m-2 badge bg-dark bg-opacity-75 rounded-pill">
                                    #@b.Id
                                </span>
                            </div>

                            <div class="p-3">
                                <h6 class="fw-bold mb-1 text-truncate" title="@p.Title">@p.Title</h6>
                                <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> @p.City, @p.State</p>

                                <div class="p-2 bg-light rounded-3 mb-3" style="font-size:0.83rem;">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Dates:</span>
                                        <strong>@b.CheckInDate.ToString("dd MMM") – @b.CheckOutDate.ToString("dd MMM yyyy")</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Length & Guests:</span>
                                        <span>@b.TotalNights nights · @b.GuestCount pax</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">Total Paid:</span>
                                        <strong class="text-danger" data-base-price="@b.TotalAmount">RM @b.TotalAmount.ToString("N0")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ACTIONS FOOTER -->
                        <div class="p-3 border-top bg-white">
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-dark rounded-pill flex-fill">
                                    <i class="bi bi-chat-dots"></i> Details & Chat
                                </a>
                                @if (b.Status != "Cancelled")
                                {
                                    <a asp-action="CheckInPass" asp-route-id="@b.Id" class="btn btn-sm btn-outline-danger rounded-pill flex-fill">
                                        <i class="bi bi-qr-code"></i> Pass
                                    </a>
                                }
                                <a asp-action="Receipt" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary rounded-pill">
                                    <i class="bi bi-receipt"></i>
                                </a>
                            </div>

                            @if (b.Status == "CheckedIn" || b.Status == "Confirmed")
                            {
                                <div class="mt-2 text-center">
                                    <a asp-action="ReportIssue" asp-route-bookingId="@b.Id" class="text-muted small text-decoration-none">
                                        <i class="bi bi-tools"></i> Need maintenance support?
                                    </a>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>
