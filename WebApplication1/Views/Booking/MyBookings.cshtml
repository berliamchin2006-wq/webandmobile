@model List<HomeNest.Models.Booking>
@{
    ViewData["Title"] = "My Trips & Reservations";
    string currentFilter = ViewBag.CurrentFilter as string ?? "all";
}

<div class="taste-wrap py-4">
    
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-3 py-1 mb-2 font-monospace" style="font-size:0.75rem;">
                <i class="bi bi-suitcase-lg-fill me-1"></i> Trip Management
            </span>
            <h2 class="fw-bold mb-1 text-dark-emphasis" style="letter-spacing: var(--tracking-tight);">My Trips & Reservations</h2>
            <p class="text-muted small mb-0">View your active stay passes, receipts, and past vacation stays</p>
        </div>
        <a asp-controller="Property" asp-action="Catalog" class="btn btn-airbnb rounded-pill px-4">
            <i class="bi bi-search me-1"></i> Explore More Stays
        </a>
    </div>

    <!-- STATUS FILTER PILLS -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="MyBookings" asp-route-filter="all" class="btn btn-sm @(currentFilter == "all" ? "btn-airbnb text-white" : "btn-secondary-taste") rounded-pill px-3">
            All Reservations (@Model.Count)
        </a>
        <a asp-action="MyBookings" asp-route-filter="upcoming" class="btn btn-sm @(currentFilter == "upcoming" ? "btn-airbnb text-white" : "btn-secondary-taste") rounded-pill px-3">
            Upcoming & Active
        </a>
        <a asp-action="MyBookings" asp-route-filter="completed" class="btn btn-sm @(currentFilter == "completed" ? "btn-airbnb text-white" : "btn-secondary-taste") rounded-pill px-3">
            Past Stays
        </a>
        <a asp-action="MyBookings" asp-route-filter="cancelled" class="btn btn-sm @(currentFilter == "cancelled" ? "btn-airbnb text-white" : "btn-secondary-taste") rounded-pill px-3">
            Cancelled
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 border rounded-4 bg-surface shadow-sm" style="border-radius: var(--r-xl) !important; background: var(--p-surface); border-color: var(--p-line) !important;">
            <i class="bi bi-suitcase-lg fs-1 text-muted"></i>
            <h4 class="mt-3 fw-bold text-dark-emphasis">No trips found</h4>
            <p class="text-muted" style="font-size:0.92rem;">You haven't booked any vacation stays matching this filter yet.</p>
            <a asp-controller="Property" asp-action="Catalog" class="btn btn-airbnb rounded-pill px-4 mt-2">Explore Malaysia Stays</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var b in Model)
            {
                var p = b.Property;
                var cover = p.Photos.FirstOrDefault(ph => ph.IsCover)?.FileName 
                    ?? p.Photos.FirstOrDefault()?.FileName 
                    ?? "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80";

                string statusBadgeClass = b.Status switch
                {
                    "Confirmed" => "bg-primary text-white",
                    "CheckedIn" => "bg-success text-white",
                    "CheckedOut" => "bg-secondary text-white",
                    "Cancelled" => "bg-danger text-white",
                    _ => "bg-warning text-dark"
                };

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card-custom h-100 position-relative d-flex flex-column justify-content-between">
                        
                        <div>
                            <div class="taste-photo-frame" style="height: 190px;">
                                <img src="@cover" alt="@p.Title" />
                                <span class="position-absolute top-0 end-0 m-2 badge @statusBadgeClass rounded-pill px-3 py-1 shadow-sm" style="font-size:0.75rem;">
                                    @b.Status
                                </span>
                                <span class="taste-type-badge">
                                    Trip #@b.Id
                                </span>
                            </div>

                            <div class="p-3">
                                <h6 class="fw-bold mb-1 text-truncate text-dark-emphasis" title="@p.Title">@p.Title</h6>
                                <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> @p.City, @p.State</p>

                                <div class="p-3 rounded-3 mb-2" style="background: var(--p-surface); border: 1px solid var(--p-line); font-size:0.84rem;">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Dates:</span>
                                        <strong class="text-dark-emphasis">@b.CheckInDate.ToString("dd MMM") – @b.CheckOutDate.ToString("dd MMM yyyy")</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Duration:</span>
                                        <span class="text-dark-emphasis">@b.TotalNights nights · @b.GuestCount pax</span>
                                    </div>
                                    <div class="d-flex justify-content-between pt-1 border-top" style="border-color: var(--p-line) !important;">
                                        <span class="text-muted">Total Paid:</span>
                                        <strong class="text-danger" data-base-price="@b.TotalAmount">RM @b.TotalAmount.ToString("N0")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ACTIONS FOOTER -->
                        <div class="p-3 border-top" style="border-color: var(--p-line) !important; background: var(--p-surface-card);">
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-taste rounded-pill flex-fill">
                                    <i class="bi bi-chat-dots"></i> Details
                                </a>
                                @if (b.Status != "Cancelled")
                                {
                                    <a asp-action="CheckInPass" asp-route-id="@b.Id" class="btn btn-sm btn-airbnb rounded-pill flex-fill">
                                        <i class="bi bi-qr-code"></i> Pass
                                    </a>
                                }
                                <a asp-action="Receipt" asp-route-id="@b.Id" class="btn btn-sm btn-secondary-taste rounded-pill" title="View Receipt">
                                    <i class="bi bi-receipt"></i>
                                </a>
                            </div>

                            @if (b.Status == "CheckedIn" || b.Status == "Confirmed")
                            {
                                <div class="mt-2 text-center">
                                    <a asp-action="ReportIssue" asp-route-bookingId="@b.Id" class="text-muted small text-decoration-none">
                                        <i class="bi bi-tools"></i> Need maintenance support?
                                    </a>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>
