@model List<HomeNest.Models.Property>
@{
    ViewData["Title"] = "Host Performance Analytics & Dashboard";
    decimal totalEarnings = ViewBag.TotalEarnings != null ? (decimal)ViewBag.TotalEarnings : 0m;
    int totalNights = ViewBag.TotalNights != null ? (int)ViewBag.TotalNights : 0;
    int upcomingArrivals = ViewBag.UpcomingArrivals != null ? (int)ViewBag.UpcomingArrivals : 0;
    int upcomingDepartures = ViewBag.UpcomingDepartures != null ? (int)ViewBag.UpcomingDepartures : 0;
}

<div class="taste-wrap py-4">
    
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill px-3 py-1 mb-2 font-monospace" style="font-size:0.75rem;">
                <i class="bi bi-graph-up-arrow me-1"></i> Host Intelligence
            </span>
            <h2 class="fw-bold mb-1 text-dark-emphasis" style="letter-spacing: var(--tracking-tight);">Host Performance Analytics</h2>
            <p class="text-muted small mb-0">Real-time revenue metrics, reservation distribution, and check-in turnover</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="HostEarnings" class="btn btn-outline-taste rounded-pill px-3">
                <i class="bi bi-wallet2 me-1"></i> Earnings Ledger
            </a>
            <a asp-action="QrScanner" class="btn btn-airbnb rounded-pill px-4">
                <i class="bi bi-qr-code-scan me-1"></i> QR Check-In Scanner
            </a>
        </div>
    </div>

    <!-- KPI METRIC CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card-custom p-4">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing:0.04em;">Host Revenue</span>
                <h3 class="fw-bold text-success mt-2 mb-1" data-base-price="@totalEarnings">RM @totalEarnings.ToString("N2")</h3>
                <small class="text-muted">Net payouts received</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card-custom p-4">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing:0.04em;">Nights Booked</span>
                <h3 class="fw-bold text-primary mt-2 mb-1">@totalNights nights</h3>
                <small class="text-muted">Across all properties</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card-custom p-4">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing:0.04em;">Arrivals Today</span>
                <h3 class="fw-bold text-dark-emphasis mt-2 mb-1">@upcomingArrivals</h3>
                <small class="text-muted">Scheduled check-ins</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card-custom p-4">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing:0.04em;">Departures Today</span>
                <h3 class="fw-bold text-dark-emphasis mt-2 mb-1">@upcomingDepartures</h3>
                <small class="text-muted">Check-outs scheduled</small>
            </div>
        </div>
    </div>

    <!-- INTERACTIVE CHARTS (CHART.JS) -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-7">
            <div class="card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark-emphasis"><i class="bi bi-bar-chart-fill text-danger me-2"></i> Monthly Earnings (MYR)</h5>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill">Last 6 Months</span>
                </div>
                <div style="height: 280px;">
                    <canvas id="monthlyEarningsChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark-emphasis"><i class="bi bi-pie-chart-fill text-primary me-2"></i> Listing Share</h5>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill">By Bookings</span>
                </div>
                <div style="height: 280px;">
                    <canvas id="listingPieChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- LISTING BREAKDOWN TABLE -->
    <div class="card-custom overflow-hidden">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--p-line) !important; background: var(--p-surface);">
            <h5 class="fw-bold mb-0 text-dark-emphasis">Individual Listing Performance</h5>
            <span class="text-muted small">@Model.Count listings</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background: var(--p-surface); font-size:0.8rem; text-transform:uppercase; letter-spacing:0.04em; color:var(--p-muted);">
                    <tr>
                        <th class="ps-4">Listing</th>
                        <th>Type & City</th>
                        <th>Base Rate</th>
                        <th>Total Bookings</th>
                        <th>Average Rating</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Manage</th>
                    </tr>
                </thead>
                <tbody style="font-size:0.88rem;">
                    @foreach (var p in Model)
                    {
                        double avgRating = p.Reviews.Any() ? Math.Round(p.Reviews.Average(r => r.OverallRating), 1) : 5.0;
                        <tr>
                            <td class="ps-4">
                                <strong class="text-dark-emphasis">@p.Title</strong>
                            </td>
                            <td class="text-muted">@p.PropertyType, @p.City</td>
                            <td><strong class="text-dark-emphasis" data-base-price="@p.BaseNightlyRate">RM @p.BaseNightlyRate.ToString("N0")</strong></td>
                            <td><span class="badge bg-primary-subtle text-primary-emphasis rounded-pill px-3">@p.Bookings.Count</span></td>
                            <td><span class="text-warning fw-bold"><i class="bi bi-star-fill"></i> @avgRating</span></td>
                            <td>
                                <span class="badge @(p.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary") rounded-pill px-3 py-1">
                                    @(p.IsActive ? "Active" : "Paused")
                                </span>
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-controller="Property" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-taste rounded-pill px-3">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const monthlyData = @Html.Raw(ViewBag.MonthlyDataJson ?? "[]");

        // 1. Monthly Earnings Bar Chart
        const months = monthlyData.map(d => d.month);
        const earnings = monthlyData.map(d => d.earnings);

        const ctx1 = document.getElementById('monthlyEarningsChart').getContext('2d');
        new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: months,
                datasets: [{
                    label: 'Host Earnings (RM)',
                    data: earnings,
                    backgroundColor: 'rgba(255, 56, 92, 0.85)',
                    borderColor: '#ff385c',
                    borderRadius: 8,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(val) { return 'RM ' + val; }
                        }
                    }
                }
            }
        });

        // 2. Listing Distribution Pie Chart
        const listingTitles = [@Html.Raw(string.Join(",", Model.Select(p => $"\"{p.Title.Replace("\"", "\\\"")[..Math.Min(20, p.Title.Length)]}...\"")))];
        const listingBookings = [@string.Join(",", Model.Select(p => p.Bookings.Count))];

        const ctx2 = document.getElementById('listingPieChart').getContext('2d');
        new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: listingTitles,
                datasets: [{
                    data: listingBookings,
                    backgroundColor: [
                        '#ff385c', '#0284c7', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    </script>
}
