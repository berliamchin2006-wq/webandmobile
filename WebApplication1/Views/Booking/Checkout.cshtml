@model HomeNest.Models.BookingCheckoutVM
@{
    ViewData["Title"] = "Confirm and Pay";
    var p = Model.Property!;
    var cover = p.Photos.FirstOrDefault(ph => ph.IsCover)?.FileName 
        ?? p.Photos.FirstOrDefault()?.FileName 
        ?? "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80";
}

@section Styles {
    <style>
        .checkout-box {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        }

        .credit-card-preview {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            color: white;
            border-radius: 16px;
            padding: 22px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
            font-family: 'Courier New', Courier, monospace;
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
        }

        .payment-method-card {
            border: 1.5px solid var(--border-color);
            border-radius: 14px;
            padding: 14px 18px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .payment-method-card.active {
            border-color: #ff385c;
            background: rgba(255, 56, 92, 0.04);
        }
    </style>
}

<div class="container py-4" style="max-width: 1050px;">
    
    <div class="mb-4">
        <a asp-controller="Property" asp-action="Details" asp-route-id="@Model.PropertyId" class="text-dark text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left"></i> Back to Property
        </a>
        <h2 class="fw-bold mt-2">Confirm and Pay</h2>
    </div>

    <form asp-action="ProcessPayment" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PropertyId" />
        <input type="hidden" asp-for="CheckInDate" />
        <input type="hidden" asp-for="CheckOutDate" />
        <input type="hidden" asp-for="GuestCount" />
        <input type="hidden" asp-for="PaymentMethod" id="inputPaymentMethod" value="Stripe (Mock Card)" />

        <div class="row g-5">
            
            <!-- LEFT COLUMN: TRIP DETAILS, PAYMENT GATEWAY & CANCELLATION -->
            <div class="col-12 col-lg-7">
                
                <!-- 1. TRIP SUMMARY -->
                <div class="checkout-box mb-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-calendar3 text-danger me-2"></i> Your Trip</h5>
                    
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <span class="fw-bold d-block">Dates</span>
                            <span class="text-muted small">@Model.CheckInDate.ToString("dd MMM yyyy") – @Model.CheckOutDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">@Model.TotalNights nights</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <span class="fw-bold d-block">Guests</span>
                            <span class="text-muted small">@Model.GuestCount guest@(Model.GuestCount > 1 ? "s" : "")</span>
                        </div>
                        <span class="text-muted small">Max @p.MaxGuests</span>
                    </div>

                    <div class="pt-3">
                        <label asp-for="SpecialRequests" class="form-label fw-semibold">Special Requests for Host (Optional)</label>
                        <textarea asp-for="SpecialRequests" rows="2" class="form-control" placeholder="Estimated arrival time, early luggage drop-off, bedding requests..."></textarea>
                    </div>
                </div>

                <!-- 2. PAYMENT METHODS (STRIPE MOCK / FPX / EWALLET) -->
                <div class="checkout-box mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0"><i class="bi bi-credit-card-2-front text-primary me-2"></i> Pay With</h5>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                            <i class="bi bi-lock-fill"></i> 256-Bit SSL Encrypted
                        </span>
                    </div>

                    <!-- Payment Method Selectors -->
                    <div class="row g-2 mb-4">
                        <div class="col-4">
                            <div class="payment-method-card active text-center" data-method="Stripe (Mock Card)">
                                <i class="bi bi-credit-card fs-4 text-danger d-block mb-1"></i>
                                <span class="fw-bold" style="font-size:0.82rem;">Credit Card</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="payment-method-card text-center" data-method="FPX Online Banking">
                                <i class="bi bi-bank fs-4 text-primary d-block mb-1"></i>
                                <span class="fw-bold" style="font-size:0.82rem;">FPX Banking</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="payment-method-card text-center" data-method="Touch 'n Go eWallet">
                                <i class="bi bi-wallet2 fs-4 text-success d-block mb-1"></i>
                                <span class="fw-bold" style="font-size:0.82rem;">TnG eWallet</span>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 1: STRIPE MOCK CREDIT CARD -->
                    <div id="stripeCardSection">
                        <!-- Interactive Visual Card -->
                        <div class="credit-card-preview">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <span class="fw-bold text-uppercase letter-spacing-1" style="font-size:0.75rem;">HomeNest Secure Card</span>
                                <i class="bi bi-stripe fs-3"></i>
                            </div>
                            <div class="fs-5 tracking-wider mb-3" id="cardDisplayNumber">•••• •••• •••• 4242</div>
                            <div class="d-flex justify-content-between" style="font-size:0.75rem;">
                                <div>
                                    <span class="text-white-50 d-block">CARDHOLDER</span>
                                    <span class="fw-bold text-uppercase" id="cardDisplayName">GUEST NAME</span>
                                </div>
                                <div>
                                    <span class="text-white-50 d-block">EXPIRES</span>
                                    <span class="fw-bold" id="cardDisplayExpiry">12/28</span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Card Number</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                                <input asp-for="CardNumber" class="form-control" id="inputCardNumber" placeholder="4242 4242 4242 4242" value="4242 4242 4242 4242" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Expiration (MM/YY)</label>
                                <input asp-for="CardExpiry" class="form-control" id="inputCardExpiry" placeholder="12/28" value="12/28" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">CVC / CVV</label>
                                <input asp-for="CardCvc" class="form-control" id="inputCardCvc" placeholder="123" value="123" />
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-semibold">Cardholder Name</label>
                            <input asp-for="CardHolder" class="form-control" id="inputCardHolder" placeholder="Full name on card" value="@User.Identity?.Name" />
                        </div>
                    </div>

                    <!-- TAB 2: MALAYSIAN FPX ONLINE BANKING -->
                    <div id="fpxSection" class="d-none">
                        <label class="form-label fw-semibold mb-2">Select Malaysian Bank</label>
                        <div class="row g-2">
                            @{
                                string[] banks = new[] { "Maybank2u", "CIMB Clicks", "Public Bank", "Hong Leong Connect", "RHB Now", "AmOnline" };
                            }
                            @foreach (var b in banks)
                            {
                                <div class="col-6">
                                    <label class="p-2 border rounded-3 w-100 d-flex align-items-center gap-2 cursor-pointer bg-light">
                                        <input type="radio" name="FpxBank" value="@b" @(b == "Maybank2u" ? "checked" : "") />
                                        <span class="fw-semibold small">@b</span>
                                    </label>
                                </div>
                            }
                        </div>
                        <p class="text-muted small mt-2 mb-0"><i class="bi bi-info-circle"></i> You will be securely redirected to simulate bank authentication.</p>
                    </div>

                    <!-- TAB 3: TOUCH 'N GO EWALLET -->
                    <div id="ewalletSection" class="d-none text-center py-3">
                        <div class="p-3 border rounded-3 bg-light d-inline-block">
                            <i class="bi bi-qr-code fs-1 text-primary"></i>
                            <p class="fw-bold mb-1 mt-2">DuitNow / Touch 'n Go QR</p>
                            <small class="text-muted">Instant mock approval simulation upon submit</small>
                        </div>
                    </div>
                </div>

                <!-- 3. CANCELLATION POLICY ENFORCEMENT NOTICE -->
                <div class="checkout-box mb-4">
                    <h5 class="fw-bold mb-2"><i class="bi bi-shield-check text-success me-2"></i> Cancellation Policy</h5>
                    <p class="fw-semibold text-dark mb-1">@p.CancellationPolicy Policy Applied:</p>
                    <p class="text-muted small mb-0">
                        @if (p.CancellationPolicy == "Flexible")
                        {
                            <span>Cancel up to 24 hours before check-in for a 100% full refund. Cancel afterwards for 50% refund minus cleaning fee.</span>
                        }
                        else if (p.CancellationPolicy == "Moderate")
                        {
                            <span>Cancel up to 5 days before check-in for a 100% full refund. Cancel afterwards for 50% refund.</span>
                        }
                        else
                        {
                            <span>Cancel up to 7 days before check-in for a 50% refund. Non-refundable afterwards.</span>
                        }
                    </p>
                </div>

                <!-- SUBMIT BUTTON -->
                <button type="submit" class="btn btn-airbnb w-100 py-3 fs-5 fw-bold shadow-lg rounded-pill mb-4">
                    <i class="bi bi-lock-fill me-1"></i> Authorize & Confirm Reservation
                </button>

            </div>

            <!-- RIGHT COLUMN: PRICE BREAKDOWN & LISTING CARD -->
            <div class="col-12 col-lg-5">
                <div class="checkout-box">
                    
                    <div class="d-flex gap-3 pb-3 border-bottom mb-3">
                        <img src="@cover" class="rounded-3" style="width:110px; height:85px; object-fit:cover;" />
                        <div>
                            <span class="badge bg-secondary mb-1" style="font-size:0.7rem;">@p.PropertyType</span>
                            <h6 class="fw-bold mb-1 text-truncate" style="max-width:200px;" title="@p.Title">@p.Title</h6>
                            <p class="text-muted small mb-0"><i class="bi bi-geo-alt"></i> @p.City, @p.State</p>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3">Price Details</h5>

                    <div class="d-flex justify-content-between mb-2" style="font-size:0.92rem;">
                        <span class="text-muted">RM @Model.NightlyRate.ToString("N0") × @Model.TotalNights nights</span>
                        <span class="fw-semibold" data-base-price="@Model.SubtotalAmount">RM @Model.SubtotalAmount.ToString("N0")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2" style="font-size:0.92rem;">
                        <span class="text-muted">Cleaning fee</span>
                        <span class="fw-semibold" data-base-price="@Model.CleaningFee">RM @Model.CleaningFee.ToString("N0")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3" style="font-size:0.92rem;">
                        <span class="text-muted">HomeNest service tax & fee (10%)</span>
                        <span class="fw-semibold" data-base-price="@Model.ServiceFee">RM @Model.ServiceFee.ToString("N0")</span>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top fw-bold fs-4 text-dark mb-3">
                        <span>Total (MYR)</span>
                        <span class="text-danger" data-base-price="@Model.TotalAmount">RM @Model.TotalAmount.ToString("N0")</span>
                    </div>

                    <div class="p-3 bg-light rounded-3" style="font-size:0.8rem; line-height:1.5;">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> <strong>Double-Booking Protection Active:</strong> Database transaction isolation ensures your selected dates cannot be claimed by another party while processing.
                    </div>

                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Tab switcher for payment methods
        $('.payment-method-card').on('click', function() {
            $('.payment-method-card').removeClass('active');
            $(this).addClass('active');

            const method = $(this).data('method');
            $('#inputPaymentMethod').val(method);

            if (method === 'Stripe (Mock Card)') {
                $('#stripeCardSection').removeClass('d-none');
                $('#fpxSection').addClass('d-none');
                $('#ewalletSection').addClass('d-none');
            } else if (method === 'FPX Online Banking') {
                $('#stripeCardSection').addClass('d-none');
                $('#fpxSection').removeClass('d-none');
                $('#ewalletSection').addClass('d-none');
            } else {
                $('#stripeCardSection').addClass('d-none');
                $('#fpxSection').addClass('d-none');
                $('#ewalletSection').removeClass('d-none');
            }
        });

        // Live credit card preview updates
        $('#inputCardNumber').on('input', function() {
            const val = $(this).val() || '•••• •••• •••• 4242';
            $('#cardDisplayNumber').text(val);
        });

        $('#inputCardExpiry').on('input', function() {
            const val = $(this).val() || '12/28';
            $('#cardDisplayExpiry').text(val);
        });

        $('#inputCardHolder').on('input', function() {
            const val = $(this).val() || 'GUEST NAME';
            $('#cardDisplayName').text(val);
        });
    </script>
}
