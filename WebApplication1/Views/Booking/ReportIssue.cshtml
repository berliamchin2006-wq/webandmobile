@model HomeNest.Models.MaintenanceRequestVM
@{
    ViewData["Title"] = "Report Maintenance / Support Issue";
    var booking = ViewBag.Booking as HomeNest.Models.Booking;
}

<div class="container py-4" style="max-width: 720px;">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-danger bg-opacity-75 rounded-pill px-3 py-1 mb-1">Module 5: In-Stay & Operations</span>
            <h2 class="fw-bold mb-0">Report In-Stay Support Issue</h2>
        </div>
        <a asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> Back to Stay
        </a>
    </div>

    @if (booking != null)
    {
        <div class="card border rounded-4 p-3 mb-4 bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold mb-1">@booking.Property.Title</h6>
                    <small class="text-muted"><i class="bi bi-calendar"></i> Check-in: @booking.CheckInDate.ToString("dd MMM yyyy") · Host: @booking.Property.Host.FullName</small>
                </div>
                <span class="badge bg-dark rounded-pill">Booking #@booking.Id</span>
            </div>
        </div>
    }

    <div class="card border rounded-4 p-4 shadow-sm bg-white">
        <form asp-action="ReportIssue" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BookingId" />

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-semibold">Issue Category *</label>
                    <select asp-for="Category" class="form-select">
                        <option value="Air-Conditioning">Air-Conditioning / HVAC</option>
                        <option value="Plumbing">Plumbing / Water Heater / Leak</option>
                        <option value="Electrical / WiFi">Electrical / Wi-Fi / Smart TV</option>
                        <option value="Cleanliness">Cleanliness / Housekeeping</option>
                        <option value="Appliances">Kitchen Appliances / Refrigerator</option>
                        <option value="Other">Other Miscellaneous Issue</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Priority" class="form-label fw-semibold">Urgency / Priority *</label>
                    <select asp-for="Priority" class="form-select">
                        <option value="Low">Low (Minor inconvenience)</option>
                        <option value="Medium" selected>Medium (Needs attention today)</option>
                        <option value="High">High (Affects comfort/sleep)</option>
                        <option value="Urgent">Urgent (Safety / Flood / Power outage)</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="IssueTitle" class="form-label fw-semibold">Issue Summary *</label>
                <input asp-for="IssueTitle" class="form-control" placeholder="e.g. Master bedroom AC leaking water" />
                <span asp-validation-for="IssueTitle" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Detailed Description *</label>
                <textarea asp-for="Description" rows="4" class="form-control" placeholder="Please describe what happened, when it started, and where the issue is located in the property..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="PhotoProof" class="form-label fw-semibold">Attach Photo Proof (Optional)</label>
                <input asp-for="PhotoProof" type="file" class="form-control" accept="image/*" />
                <small class="text-muted">Upload a photo showing the issue to help the host resolve it quickly.</small>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-airbnb rounded-pill px-5 fw-bold shadow">
                    Submit Issue Ticket
                </button>
            </div>
        </form>
    </div>

</div>

