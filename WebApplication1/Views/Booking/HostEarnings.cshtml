@model List<HomeNest.Models.Payment>
@{
    ViewData["Title"] = "Host Earnings Ledger & Payout Disbursements";
    decimal totalGross = Model.Where(p => p.PaymentType == "FullPayment").Sum(p => p.Amount);
    decimal totalHostPayout = Model.Where(p => p.PaymentType == "FullPayment").Sum(p => p.HostPayoutAmount);
    decimal totalPending = Model.Where(p => p.PaymentType == "FullPayment" && p.HostPayoutStatus == "Pending").Sum(p => p.HostPayoutAmount);
    decimal totalDisbursed = Model.Where(p => p.PaymentType == "FullPayment" && p.HostPayoutStatus == "Disbursed").Sum(p => p.HostPayoutAmount);
}

<div class="taste-wrap py-4">
    
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-1 mb-2 font-monospace" style="font-size:0.75rem;">
                <i class="bi bi-wallet2 me-1"></i> Host Operations
            </span>
            <h2 class="fw-bold mb-1 text-dark-emphasis" style="letter-spacing: var(--tracking-tight);">Host Payouts & Financial Ledger</h2>
            <p class="text-muted small mb-0">Track gross booking receipts, platform commissions, and automated bank disbursements</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportFinancialCsv" class="btn btn-outline-taste rounded-pill px-3">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Financial CSV
            </a>
            <a asp-action="HostDashboard" class="btn btn-airbnb rounded-pill px-4">
                <i class="bi bi-graph-up me-1"></i> Performance Analytics
            </a>
        </div>
    </div>

    <!-- SUMMARY METRICS CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card-custom p-4">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing:0.04em;">Gross Bookings</span>
                <h3 class="fw-bold text-dark-emphasis mt-2 mb-1" data-base-price="@totalGross">RM @totalGross.ToString("N2")</h3>
                <small class="text-muted">Total transaction volume</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card-custom p-4">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing:0.04em;">Net Host Earnings</span>
                <h3 class="fw-bold text-success mt-2 mb-1" data-base-price="@totalHostPayout">RM @totalHostPayout.ToString("N2")</h3>
                <small class="text-muted">After 3% platform fee</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card-custom p-4">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing:0.04em;">Pending Payouts</span>
                <h3 class="fw-bold text-warning mt-2 mb-1" data-base-price="@totalPending">RM @totalPending.ToString("N2")</h3>
                <small class="text-muted">Ready for bank transfer</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card-custom p-4">
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing:0.04em;">Disbursed to Bank</span>
                <h3 class="fw-bold text-primary mt-2 mb-1" data-base-price="@totalDisbursed">RM @totalDisbursed.ToString("N2")</h3>
                <small class="text-muted">Completed bank deposits</small>
            </div>
        </div>
    </div>

    <!-- HOST PAYOUT DESTINATION BANK ACCOUNT -->
    <div class="card-custom p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-xs" style="width:48px; height:48px;">
                    <i class="bi bi-bank fs-4"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0 text-dark-emphasis">Verified Bank Account for Direct Payouts</h5>
                    <p class="text-muted small mb-0">Maybank Berhad · Account ending in <strong>**** 4892</strong> (Tan Ah Kow)</p>
                </div>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                <i class="bi bi-check-circle-fill me-1"></i> Active Direct Deposit
            </span>
        </div>
    </div>

    <!-- DETAILED TRANSACTION TABLE -->
    <div class="card-custom overflow-hidden mb-4">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--p-line) !important; background: var(--p-surface);">
            <h5 class="fw-bold mb-0 text-dark-emphasis">Transaction Ledger (@Model.Count)</h5>
            <span class="text-muted small">Updated in real-time</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead style="background: var(--p-surface); font-size:0.8rem; text-transform:uppercase; letter-spacing:0.04em; color:var(--p-muted);">
                    <tr>
                        <th class="ps-4">Tx ID</th>
                        <th>Date</th>
                        <th>Property</th>
                        <th>Guest</th>
                        <th>Gross Booking</th>
                        <th>Platform Fee (3%)</th>
                        <th>Net Payout</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody style="font-size:0.88rem;">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No payout records generated yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Model)
                        {
                            var booking = p.Booking;
                            var prop = booking?.Property;
                            string statusBadge = p.HostPayoutStatus switch
                            {
                                "Disbursed" => "bg-success-subtle text-success border border-success-subtle",
                                "Pending" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                _ => "bg-secondary-subtle text-secondary"
                            };

                            <tr>
                                <td class="ps-4 font-monospace fw-bold text-dark-emphasis">#@p.Id</td>
                                <td class="text-muted">@p.PaymentDate.ToString("dd MMM yyyy, HH:mm")</td>
                                <td>
                                    <strong class="d-block text-truncate text-dark-emphasis" style="max-width:200px;">@prop?.Title</strong>
                                    <small class="text-muted">@prop?.City</small>
                                </td>
                                <td>@booking?.Guest?.FullName</td>
                                <td class="fw-bold" data-base-price="@p.Amount">RM @p.Amount.ToString("N2")</td>
                                <td class="text-danger" data-base-price="@(p.Amount - p.HostPayoutAmount)">RM @((p.Amount - p.HostPayoutAmount).ToString("N2"))</td>
                                <td class="fw-bolder text-success fs-6" data-base-price="@p.HostPayoutAmount">RM @p.HostPayoutAmount.ToString("N2")</td>
                                <td>
                                    <span class="badge @statusBadge rounded-pill px-3 py-1">@p.HostPayoutStatus</span>
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Receipt" asp-route-id="@booking?.Id" class="btn btn-sm btn-outline-taste rounded-pill px-3">
                                        View Receipt
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
