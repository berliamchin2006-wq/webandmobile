@model List<HomeNest.Models.Payment>
@{
    ViewData["Title"] = "Host Earnings Ledger & Payout Disbursements";
    decimal totalGross = Model.Where(p => p.PaymentType == "FullPayment").Sum(p => p.Amount);
    decimal totalHostPayout = Model.Where(p => p.PaymentType == "FullPayment").Sum(p => p.HostPayoutAmount);
    decimal totalPending = Model.Where(p => p.PaymentType == "FullPayment" && p.HostPayoutStatus == "Pending").Sum(p => p.HostPayoutAmount);
    decimal totalDisbursed = Model.Where(p => p.PaymentType == "FullPayment" && p.HostPayoutStatus == "Disbursed").Sum(p => p.HostPayoutAmount);
}

<div class="container py-4">
    
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-success bg-opacity-75 rounded-pill px-3 py-1 mb-1">Module 4.2: Host Earnings & Payout Ledger</span>
            <h2 class="fw-bold mb-0">Host Payouts & Financial Ledger</h2>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-action="ExportFinancialCsv" class="btn btn-outline-dark rounded-pill px-3">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Financial CSV
            </a>
            <a asp-action="HostDashboard" class="btn btn-airbnb rounded-pill px-4">
                <i class="bi bi-graph-up me-1"></i> Performance Analytics
            </a>
        </div>
    </div>

    <!-- SUMMARY METRICS CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border rounded-4 p-3 shadow-sm bg-white">
                <span class="text-muted small text-uppercase fw-bold">Gross Guest Bookings</span>
                <h3 class="fw-bold text-dark mt-1 mb-0" data-base-price="@totalGross">RM @totalGross.ToString("N2")</h3>
                <small class="text-muted">Total transaction volume</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border rounded-4 p-3 shadow-sm bg-white">
                <span class="text-muted small text-uppercase fw-bold">Net Host Earnings</span>
                <h3 class="fw-bold text-success mt-1 mb-0" data-base-price="@totalHostPayout">RM @totalHostPayout.ToString("N2")</h3>
                <small class="text-muted">After 3% platform commission</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border rounded-4 p-3 shadow-sm bg-white">
                <span class="text-muted small text-uppercase fw-bold">Pending Payouts</span>
                <h3 class="fw-bold text-warning mt-1 mb-0" data-base-price="@totalPending">RM @totalPending.ToString("N2")</h3>
                <small class="text-muted">Ready for bank transfer</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border rounded-4 p-3 shadow-sm bg-white">
                <span class="text-muted small text-uppercase fw-bold">Disbursed to Bank</span>
                <h3 class="fw-bold text-primary mt-1 mb-0" data-base-price="@totalDisbursed">RM @totalDisbursed.ToString("N2")</h3>
                <small class="text-muted">Completed bank deposits</small>
            </div>
        </div>
    </div>

    <!-- HOST PAYOUT DESTINATION BANK ACCOUNT -->
    <div class="card border rounded-4 p-4 shadow-sm mb-4 bg-light">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:48px; height:48px;">
                    <i class="bi bi-bank2 fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Disbursement Destination: @ViewBag.HostBankName</h6>
                    <p class="text-muted small mb-0">Account: <strong>@ViewBag.HostBankAccountMasked</strong> · Beneficiary: @ViewBag.HostBankHolder</p>
                </div>
            </div>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-outline-dark rounded-pill px-3 mt-2 mt-md-0">
                <i class="bi bi-pencil"></i> Update Bank Details
            </a>
        </div>
    </div>

    <!-- PAYOUT TRANSACTIONS TABLE -->
    <div class="card border rounded-4 shadow-sm overflow-hidden bg-white">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Disbursement Ledger Records</h5>
            <span class="text-muted small">@Model.Count entries</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Txn Ref</th>
                        <th>Booking & Listing</th>
                        <th>Guest</th>
                        <th>Total Paid</th>
                        <th>Net Payout</th>
                        <th>Payout Status</th>
                        <th>Disbursed At</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <strong class="small d-block">@p.TransactionRef</strong>
                                <span class="text-muted" style="font-size:0.75rem;">@p.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@p.BookingId" class="text-decoration-none fw-semibold text-dark">
                                    #@p.BookingId - @p.Booking?.Property?.Title
                                </a>
                            </td>
                            <td>
                                @p.Booking?.Guest?.FullName
                            </td>
                            <td>
                                <strong data-base-price="@p.Amount">RM @p.Amount.ToString("N2")</strong>
                            </td>
                            <td>
                                <strong class="text-success" data-base-price="@p.HostPayoutAmount">RM @p.HostPayoutAmount.ToString("N2")</strong>
                            </td>
                            <td>
                                <span class="badge @(p.HostPayoutStatus == "Disbursed" ? "bg-success" : (p.HostPayoutStatus == "Cancelled" ? "bg-danger" : "bg-warning text-dark")) rounded-pill px-3 py-1">
                                    @p.HostPayoutStatus
                                </span>
                            </td>
                            <td class="small text-muted">
                                @(p.HostPayoutDisbursedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                            </td>
                            <td class="text-end">
                                @if (p.HostPayoutStatus == "Pending" && p.PaymentType == "FullPayment")
                                {
                                    <form asp-action="DisbursePayout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="paymentId" value="@p.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                            <i class="bi bi-send-check"></i> Disburse
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="bi bi-check-all text-success"></i> Complete</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

