@model List<HomeNest.Models.TenancyBooking>

@{
    ViewData["Title"] = "Leases & Billing";
    bool isTenant = User.IsInRole("Tenant");
}

<div class="mb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="color: #0f172a;">
                <i class="bi bi-file-earmark-text text-teal me-2"></i>Tenancy Leases & Billing
            </h2>
            <p class="text-muted small mb-0">
                Transparent deposit breakdown, payment ledger, and digital lease tracking.
            </p>
        </div>
        <a asp-controller="Property" asp-action="Catalog" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-search me-1"></i> Browse More Rooms
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center rounded-4">
            <i class="bi bi-file-earmark-x display-3 text-muted mb-3"></i>
            <h4>No Active or Pending Leases</h4>
            <p class="text-muted">You haven't applied for any room tenancies yet.</p>
            <div class="mt-2">
                <a asp-controller="Property" asp-action="Catalog" class="btn btn-primary px-4" style="background:#0d9488; border-color:#0d9488;">
                    Find a Room
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive bg-white rounded-4 shadow-sm p-3 border">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Lease Ref</th>
                        <th>Property & Room</th>
                        <th>Tenure Period</th>
                        <th>Agreed Rent</th>
                        <th>Deposit Breakdown</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        var statusBadge = b.Status switch
                        {
                            "Active" => "bg-success text-white",
                            "ApprovedWaitingPayment" => "bg-primary text-white",
                            "PendingApproval" => "bg-warning text-dark",
                            "Rejected" => "bg-danger text-white",
                            _ => "bg-secondary text-white"
                        };

                        var latestPayment = b.Payments.OrderByDescending(p => p.PaymentDate).FirstOrDefault();

                        <tr>
                            <td>
                                <strong>#LK-@b.Id.ToString("D4")</strong>
                                <small class="text-muted d-block">@b.BookingDate.ToString("dd MMM yyyy")</small>
                            </td>
                            <td>
                                <div class="fw-bold">@b.RoomUnit.RoomName</div>
                                <small class="text-muted text-truncate d-block" style="max-width: 200px;">@b.RoomUnit.Property.Title</small>
                            </td>
                            <td>
                                <div>@b.StartDate.ToString("dd MMM yyyy") - @b.EndDate.ToString("dd MMM yyyy")</div>
                                <small class="text-muted">(@b.DurationMonths months)</small>
                            </td>
                            <td>
                                <span class="fw-bold" style="color: #0d9488;">RM @b.AgreedMonthlyRent.ToString("N0")</span>
                                <small class="text-muted">/mo</small>
                            </td>
                            <td>
                                <div class="small">
                                    <div>Sec: RM @b.RoomUnit.SecurityDeposit.ToString("N0") | Util: RM @b.RoomUnit.UtilityDeposit.ToString("N0")</div>
                                    <div class="fw-bold text-dark">Total: RM @b.TotalDepositPaid.ToString("N0")</div>
                                </div>
                            </td>
                            <td>
                                <span class="badge @statusBadge px-2 py-1">@b.Status</span>
                            </td>
                            <td class="text-end">
                                @if (b.Status == "PendingApproval" && !isTenant)
                                {
                                    <form asp-action="ApproveLease" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-check-lg"></i> Approve
                                        </button>
                                    </form>
                                }

                                @if (b.Status == "ApprovedWaitingPayment" && isTenant)
                                {
                                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#payDepositModal-@b.Id">
                                        <i class="bi bi-credit-card me-1"></i> Pay Deposit
                                    </button>

                                    <!-- Payment Modal -->
                                    <div class="modal fade" id="payDepositModal-@b.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content text-start">
                                                <form asp-action="PayDeposit" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bookingId" value="@b.Id" />
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold">Pay Deposit & Advance Rent</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="alert alert-light border p-3 mb-3">
                                                            <div class="d-flex justify-content-between mb-1">
                                                                <span>Advance 1st Month Rent:</span>
                                                                <strong>RM @b.AgreedMonthlyRent.ToString("N2")</strong>
                                                            </div>
                                                            <div class="d-flex justify-content-between mb-1">
                                                                <span>Security Deposit (refundable):</span>
                                                                <strong>RM @b.RoomUnit.SecurityDeposit.ToString("N2")</strong>
                                                            </div>
                                                            <div class="d-flex justify-content-between mb-1">
                                                                <span>Utility Deposit (refundable):</span>
                                                                <strong>RM @b.RoomUnit.UtilityDeposit.ToString("N2")</strong>
                                                            </div>
                                                            <hr />
                                                            <div class="d-flex justify-content-between fs-5 fw-bold text-success">
                                                                <span>Total Payable:</span>
                                                                <span>RM @b.TotalDepositPaid.ToString("N2")</span>
                                                            </div>
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Select Payment Gateway</label>
                                                            <select name="paymentMethod" class="form-select">
                                                                <option value="FPX Online Banking (Maybank, CIMB, Public Bank)">FPX Online Banking (Instant)</option>
                                                                <option value="Stripe Credit / Debit Card">Credit / Debit Card (Visa / Mastercard)</option>
                                                                <option value="Touch 'n Go eWallet">Touch 'n Go eWallet</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success fw-bold">Confirm & Pay RM @b.TotalDepositPaid.ToString("N0")</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (latestPayment != null)
                                {
                                    <a asp-action="Receipt" asp-route-id="@latestPayment.Id" class="btn btn-sm btn-outline-secondary ms-1">
                                        <i class="bi bi-receipt"></i> E-Receipt
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

