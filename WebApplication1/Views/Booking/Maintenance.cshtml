@model List<HomeNest.Models.MaintenanceTicket>
@{
    ViewData["Title"] = "In-Stay Service & Maintenance Tickets";
    bool isHostOrAdmin = User.IsInRole("Host") || User.IsInRole("Admin");
}

<div class="container py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-danger bg-opacity-75 rounded-pill px-3 py-1 mb-1">Module 5: In-Stay & Operations</span>
            <h2 class="fw-bold mb-0">Maintenance & Service Tickets (@Model.Count)</h2>
        </div>
        <a asp-action="MyBookings" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left"></i> My Trips
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 border rounded-4 bg-light">
            <i class="bi bi-tools fs-1 text-muted"></i>
            <h4 class="mt-3 fw-bold">No maintenance tickets reported</h4>
            <p class="text-muted">All active stays are operating smoothly without reported issues.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var t in Model)
            {
                string priorityClass = t.Priority switch
                {
                    "Urgent" => "bg-danger text-white",
                    "High" => "bg-warning text-dark",
                    "Medium" => "bg-primary text-white",
                    _ => "bg-secondary text-white"
                };

                string statusClass = t.Status switch
                {
                    "Resolved" => "bg-success text-white",
                    "In-Progress" => "bg-info text-dark",
                    _ => "bg-warning text-dark"
                };

                <div class="col-12 col-lg-6">
                    <div class="card h-100 border rounded-4 shadow-sm p-4 d-flex flex-column justify-content-between">
                        
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge @priorityClass rounded-pill me-1">@t.Priority Priority</span>
                                    <span class="badge @statusClass rounded-pill">@t.Status</span>
                                </div>
                                <span class="text-muted small">@t.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>

                            <h5 class="fw-bold mb-1">@t.IssueTitle</h5>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-house"></i> <strong>@t.Booking?.Property?.Title</strong> (Booking #@t.BookingId)
                            </p>

                            <div class="p-3 bg-light rounded-3 mb-3" style="font-size:0.88rem; line-height:1.5;">
                                <div class="mb-1"><strong>Category:</strong> @t.Category</div>
                                <div>@t.Description</div>
                            </div>

                            @if (!string.IsNullOrEmpty(t.PhotoProof))
                            {
                                <div class="mb-3">
                                    <a href="/uploads/tickets/@t.PhotoProof" target="_blank" class="d-inline-block">
                                        <img src="/uploads/tickets/@t.PhotoProof" class="rounded border" style="width:100px; height:80px; object-fit:cover;" />
                                    </a>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(t.ResolutionNotes))
                            {
                                <div class="p-2 border-start border-3 border-success bg-success bg-opacity-10 rounded mb-3" style="font-size:0.85rem;">
                                    <strong>Resolution Notes:</strong> @t.ResolutionNotes
                                    @if (t.RepairCost > 0)
                                    {
                                        <span class="d-block text-muted">Repair Expense: RM @t.RepairCost.ToString("N2")</span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- HOST / ADMIN RESOLUTION FORM -->
                        @if (isHostOrAdmin)
                        {
                            <div class="pt-3 border-top mt-3">
                                <form asp-action="UpdateTicketStatus" method="post" class="row g-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    
                                    <div class="col-4">
                                        <select name="status" class="form-select form-select-sm">
                                            <option value="Reported" selected="@(t.Status == "Reported")">Reported</option>
                                            <option value="In-Progress" selected="@(t.Status == "In-Progress")">In-Progress</option>
                                            <option value="Resolved" selected="@(t.Status == "Resolved")">Resolved</option>
                                        </select>
                                    </div>
                                    <div class="col-5">
                                        <input type="text" name="notes" class="form-control form-control-sm" placeholder="Resolution notes..." value="@t.ResolutionNotes" />
                                    </div>
                                    <div class="col-3 text-end">
                                        <button type="submit" class="btn btn-sm btn-dark w-100 rounded-pill">
                                            Update
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
    }

</div>
