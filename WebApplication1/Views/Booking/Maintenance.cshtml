@model List<HomeNest.Models.MaintenanceTicket>

@{
    ViewData["Title"] = "Maintenance & Support";
    bool isTenant = User.IsInRole("Tenant");
    var activeLeases = ViewBag.ActiveLeases as List<HomeNest.Models.TenancyBooking> ?? new List<HomeNest.Models.TenancyBooking>();
}

<div class="mb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="color: #0f172a;">
                <i class="bi bi-tools text-teal me-2"></i>Maintenance & Repairs
            </h2>
            <p class="text-muted small mb-0">
                Report property defects, track repair progress, and maintain incident records.
            </p>
        </div>
        @if (isTenant && activeLeases.Any())
        {
            <button type="button" class="btn btn-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#reportIssueModal" style="background:#0d9488; border-color:#0d9488;">
                <i class="bi bi-plus-circle me-1"></i> Report Defect / Issue
            </button>
        }
    </div>

    <!-- Tenant Ticket Submission Modal -->
    @if (isTenant && activeLeases.Any())
    {
        <div class="modal fade" id="reportIssueModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content text-start">
                    <form asp-action="ReportIssue" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold">Report Maintenance Issue</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Rented Unit *</label>
                                <select name="tenancyBookingId" class="form-select" required>
                                    @foreach (var l in activeLeases)
                                    {
                                        <option value="@l.Id">@l.RoomUnit.Property.Title - @l.RoomUnit.RoomName</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Issue Title *</label>
                                <input type="text" name="issueTitle" class="form-control" placeholder="e.g. Air-conditioner not cold / leaking water" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Priority Level *</label>
                                <select name="priority" class="form-select">
                                    <option value="Low">Low (General inquiry / cosmetic)</option>
                                    <option value="Medium" selected>Medium (Standard repair needed)</option>
                                    <option value="High">High (Affects daily living)</option>
                                    <option value="Urgent">Urgent (Water pipe burst / Electrical blackout)</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Problem Description *</label>
                                <textarea name="description" class="form-control" rows="3" placeholder="Provide details on when the issue started and the current condition..." required></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Photo Proof (Optional)</label>
                                <input type="file" name="photo" class="form-control" accept="image/*" />
                                <small class="text-muted">Upload a photo of the defect for the landlord to review.</small>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary" style="background:#0d9488; border-color:#0d9488;">Submit Ticket</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Tickets Table -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center rounded-4">
            <i class="bi bi-shield-check display-3 text-success mb-3"></i>
            <h4>No Maintenance Tickets Logged</h4>
            <p class="text-muted">All premises are in good working condition.</p>
        </div>
    }
    else
    {
        <div class="table-responsive bg-white rounded-4 shadow-sm p-3 border">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ticket ID</th>
                        <th>Premises & Room</th>
                        <th>Defect Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Repair Cost</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        var priorityBadge = t.Priority switch
                        {
                            "Urgent" => "bg-danger text-white",
                            "High" => "bg-warning text-dark",
                            "Medium" => "bg-info text-dark",
                            _ => "bg-light text-secondary border"
                        };

                        var statusBadge = t.Status switch
                        {
                            "Resolved" => "bg-success text-white",
                            "InProgress" => "bg-primary text-white",
                            _ => "bg-warning text-dark"
                        };

                        <tr>
                            <td>
                                <strong>#TK-@t.Id.ToString("D4")</strong>
                                <small class="text-muted d-block">@t.CreatedAt.ToString("dd MMM yyyy")</small>
                            </td>
                            <td>
                                <div class="fw-bold">@t.TenancyBooking.RoomUnit.RoomName</div>
                                <small class="text-muted">@t.TenancyBooking.RoomUnit.Property.Title</small>
                            </td>
                            <td>
                                <div class="fw-bold">@t.IssueTitle</div>
                                <small class="text-muted text-truncate d-block" style="max-width: 250px;">@t.Description</small>
                                @if (!string.IsNullOrEmpty(t.PhotoProof))
                                {
                                    <a href="~/uploads/maintenance/@t.PhotoProof" target="_blank" class="badge bg-light text-primary border text-decoration-none mt-1">
                                        <i class="bi bi-image me-1"></i> View Photo
                                    </a>
                                }
                            </td>
                            <td><span class="badge @priorityBadge">@t.Priority</span></td>
                            <td><span class="badge @statusBadge">@t.Status</span></td>
                            <td>
                                @(t.RepairCost > 0 ? $"RM {t.RepairCost:N2}" : "-")
                            </td>
                            <td class="text-end">
                                @if (!isTenant && t.Status != "Resolved")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#updateModal-@t.Id">
                                        Update
                                    </button>

                                    <!-- Update Ticket Modal -->
                                    <div class="modal fade" id="updateModal-@t.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content text-start">
                                                <form asp-action="UpdateTicket" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@t.Id" />
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold">Update Ticket #@t.Id</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Status</label>
                                                            <select name="status" class="form-select">
                                                                <option value="InProgress" selected="@(t.Status == "InProgress")">In Progress (Technician Assigned)</option>
                                                                <option value="Resolved" selected="@(t.Status == "Resolved")">Resolved (Completed)</option>
                                                            </select>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Repair Cost (MYR)</label>
                                                            <input type="number" step="10" name="repairCost" class="form-control" value="@t.RepairCost" />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary">Save Changes</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (t.Status == "Resolved")
                                {
                                    <span class="text-success small fw-semibold"><i class="bi bi-check-circle-fill"></i> Completed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

