@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container-fluid px-lg-5 py-5" style="max-width: 900px; margin: 0 auto;">
    <div class="card-custom p-4 p-md-5">
        <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-3 py-1 mb-2 font-monospace" style="font-size:0.75rem;">
            Security & Compliance
        </span>
        <h1 class="fw-bold mb-3 text-dark-emphasis" style="letter-spacing: var(--tracking-tight);">Privacy Policy</h1>
        <p class="text-muted mb-4" style="font-size:0.95rem;">
            Effective Date: @DateTime.Now.Year. HomeNest is dedicated to safeguarding guest reservation data, host payment information, and platform security.
        </p>

        <hr style="border-color: var(--p-line);" />

        <div class="mt-4">
            <h5 class="fw-bold text-dark-emphasis mb-2">1. Information We Collect</h5>
            <p class="text-muted" style="line-height:1.7;">
                We collect personal information required for identity verification, reservation processing, and platform communications, including your name, email address, phone number, and optional host verification photos.
            </p>

            <h5 class="fw-bold text-dark-emphasis mb-2 mt-4">2. Security & Verification</h5>
            <p class="text-muted" style="line-height:1.7;">
                Our security architecture includes a 3-strike progressive lockout policy for abnormal authentication attempts, cryptographically signed QR passes for check-in verification, and manual cookie-based session handling.
            </p>

            <h5 class="fw-bold text-dark-emphasis mb-2 mt-4">3. Data Retention & Cookies</h5>
            <p class="text-muted" style="line-height:1.7;">
                Cookies are utilized solely for essential authentication and session state preservation. We do not sell personal data to third-party advertisers.
            </p>
        </div>
    </div>
</div>
